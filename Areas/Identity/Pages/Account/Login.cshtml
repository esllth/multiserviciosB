@page
@model LoginModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Multiservicio Bolívar</title>
    <script>
        try {
            const temaGuardado = localStorage.getItem('multiservicio-theme');
            if (temaGuardado === 'dark' || temaGuardado === 'light') {
                document.documentElement.dataset.theme = temaGuardado;
            }
        } catch {
            // La página usa el tema claro si el navegador bloquea el almacenamiento local.
        }
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-body auth-only auth-login">

    <div class="login-header">
        <div class="site-container login-header-content auth-header">
            <a asp-controller="Home" asp-action="Index" class="auth-logo-link" aria-label="Multiservicio Bolívar">
                <img src="@(Url.Content("~/images/Logo/logo.png"))" class="brand-logo" alt="Logo Multiservicio Bolívar" asp-append-version="true" />
            </a>
            <a asp-page="./Register" class="btn btn-auth-primary auth-action">Registrarse</a>
        </div>
    </div>

    <main class="main-content login-page">
        <div class="login-left">
            <div class="login-box">
                <h2>Bienvenido</h2>
                <p>Inicia sesión para cotizar servicios.</p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" type="email" placeholder="Correo" autocomplete="username" />
                        <label asp-for="Input.Email">Correo</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" type="password" placeholder="Contraseña" autocomplete="current-password" />
                        <label asp-for="Input.Password">Contraseña</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    @if (Model.ShowCaptcha)
                    {
                        <input asp-for="Input.CaptchaToken" type="hidden" />
                        <div class="form-floating mb-3">
                            <input asp-for="Input.CaptchaAnswer" class="form-control" inputmode="numeric" autocomplete="off" placeholder="Respuesta" />
                            <label asp-for="Input.CaptchaAnswer">@Model.CaptchaQuestion</label>
                        </div>
                    }

                    <button type="submit" class="btn btn-auth-primary w-100">Iniciar sesión</button>

                    <div class="text-center mt-3">
                        <a asp-page="./ForgotPassword" class="auth-secondary-link">Olvidé mi contraseña</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="login-right login-right-picture" style="background:linear-gradient( rgba(0,0,0,0.22), rgba(0,0,0,0.22) ), url('@Url.Content("~/images/Login/login-bg.jpg")') center/cover no-repeat;"></div>
    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
