@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5 text-center">
                    <i class="bi bi-shield-lock display-4 text-warning" aria-hidden="true"></i>
                    <h1 class="site-heading mt-3">Acceso denegado</h1>
                    <p class="text-muted">
                        Tu cuenta inició sesión correctamente, pero no tiene permisos para acceder a esta sección.
                    </p>
                    <p class="small text-muted">
                        Si tu rol fue modificado recientemente, cierra sesión y vuelve a ingresar.
                    </p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
                        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary">
                            Ir al Dashboard
                        </a>
                        @if (Model.CanReturn)
                        {
                            <a href="@Model.ReturnUrl" class="btn btn-outline-secondary">
                                Intentar volver
                            </a>
                        }
                        <form asp-page="./Logout" method="post">
                            <button type="submit" class="btn btn-outline-danger">Cerrar sesión</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
