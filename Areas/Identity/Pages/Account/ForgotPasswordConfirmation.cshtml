@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Recuperación enviada";
}

<section class="container py-5">
    <h1 class="site-heading">Revisa tu correo</h1>
    <p class="text-muted">Si el correo existe en el sistema, se envió un enlace para restablecer la contraseña.</p>
    @if (TempData["DevPasswordResetLink"] is string devLink)
    {
        <div class="alert alert-warning">
            <strong>Modo desarrollo:</strong>
            SMTP no esta configurado. Use este enlace para probar la recuperacion:
            <a href="@devLink" class="alert-link">@devLink</a>
        </div>
    }
    <a asp-page="./Login" class="btn btn-action-cancel">Volver al login</a>
</section>
