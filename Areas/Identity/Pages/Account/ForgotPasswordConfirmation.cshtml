@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Recuperacion enviada";
    var resetLink = TempData["PasswordResetLink"] as string;
}

<section class="container py-5">
    <h1 class="site-heading">Revisa tu correo</h1>
    <p class="text-muted">Si el correo existe en el sistema, se envio un enlace para restablecer la contraseña/p>
    @if (!string.IsNullOrWhiteSpace(resetLink))
    {
        <p>
            <a href="@resetLink" class="btn btn-outline-secondary">Abrir enlace de recuperacion</a>
        </p>
    }
    <a asp-page="./Login" class="btn btn-primary">Volver al login</a>
</section>
