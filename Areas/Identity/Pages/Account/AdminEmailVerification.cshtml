@page
@model AdminEmailVerificationModel
@{
    ViewData["Title"] = "Verificar acceso";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h1 class="site-heading">Verificar acceso administrativo</h1>
            <p class="text-muted">Ingresa el código de seis dígitos enviado a tu correo.</p>
            <form method="post">
                <input asp-for="ChallengeId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" placeholder="Código" />
                    <label asp-for="Code">Código</label>
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-action-save w-100">Verificar</button>
            </form>
        </div>
    </div>
</section>
