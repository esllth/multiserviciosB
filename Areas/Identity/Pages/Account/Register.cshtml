@page
@model RegisterModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        try {
            const temaGuardado = localStorage.getItem('multiservicio-theme');
            if (temaGuardado === 'dark' || temaGuardado === 'light') {
                document.documentElement.dataset.theme = temaGuardado;
            }
        } catch {
            // Se conserva el tema claro si el navegador bloquea el almacenamiento local.
        }
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <title>Registro</title>
</head>

<body class="layout-body auth-only">

    <div class="login-header">
        <div class="site-container login-header-content auth-header">
            <a asp-controller="Home"
               asp-action="Index"
               class="auth-logo-link"
               aria-label="Multiservicio Bolívar">
                <img src="@(Url.Content("~/images/Logo/logo.png"))"
                     class="brand-logo"
                     alt="Logo Multiservicio Bolívar"
                     asp-append-version="true" />
            </a>
            <a asp-page="./Login" class="btn btn-auth-primary auth-action">Iniciar sesión</a>
        </div>
    </div>

    <main class="main-content login-page">

        <div class="login-left">
            <div class="login-box">

                <h2>Crear cuenta</h2>
                <p>Regístrate para comenzar.</p>

                <form method="post" id="formulario-registro">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" type="email" placeholder="Correo" autocomplete="username" />
                        <label asp-for="Input.Email">Correo</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" type="password" placeholder="Contraseña" autocomplete="new-password" />
                        <label asp-for="Input.Password">Contraseña</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Confirmar contraseña" autocomplete="new-password" />
                        <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Input.AceptaTerminosCotizacionPago" class="form-check-input" id="acepta-terminos" />
                        <label asp-for="Input.AceptaTerminosCotizacionPago" class="form-check-label">
                            He leido y acepto las condiciones.
                        </label>
                        <span asp-validation-for="Input.AceptaTerminosCotizacionPago" class="text-danger d-block" id="error-terminos"></span>
                    </div>

                    <button type="submit" class="btn btn-auth-primary w-100" id="registrarse">
                        Registrarse
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Legal" asp-action="Terminos" target="_blank" rel="noopener" class="text-primary small">
                            Leer términos y condiciones
                        </a>
                    </div>

                </form>

            </div>
        </div>

        <div class="login-right login-right-picture" style="background:linear-gradient( rgba(0,0,0,0.22), rgba(0,0,0,0.22) ), url('@Url.Content("~/images/Login/login-bg.jpg")') center/cover no-repeat;"></div>

    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const aceptaTerminos = document.getElementById('acepta-terminos');
        const formularioRegistro = document.getElementById('formulario-registro');
        const errorTerminos = document.getElementById('error-terminos');
        let intentoRegistroSinAceptar = false;

        const actualizarAvisoTerminos = () => {
            errorTerminos.textContent = intentoRegistroSinAceptar && !aceptaTerminos.checked
                ? 'Debe aceptar los términos y condiciones para continuar.'
                : '';
        };

        formularioRegistro.addEventListener('submit', (event) => {
            if (!aceptaTerminos.checked) {
                event.preventDefault();
                intentoRegistroSinAceptar = true;
                actualizarAvisoTerminos();
                aceptaTerminos.focus();
            }
        });

        aceptaTerminos.addEventListener('change', actualizarAvisoTerminos);
    </script>

</body>
</html>
