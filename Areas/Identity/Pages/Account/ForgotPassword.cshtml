@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<section class="container py-5 forgot-password-page">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-md-8 col-lg-5 forgot-password-card">
            <h1 class="site-heading mb-2">@ViewData["Title"]</h1>
            <p class="text-muted mb-4">Ingresa tu correo para recibir el enlace de restablecimiento.</p>

            <form method="post" class="forgot-password-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="correo@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-action-save">Enviar enlace</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
