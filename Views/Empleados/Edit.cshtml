@model MultiservicioB.Models.Empleado
@{ 
    ViewData["Title"] = "Editar empleado";
    var esAdministradorPrincipal = string.Equals(
        Model.CorreoElectronicoEmpleado?.Trim(),
        "admin@multiserviciosb.com",
        StringComparison.OrdinalIgnoreCase);
}

<section class="container py-4">
    <h1 class="site-heading">Editar empleado</h1>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-3">
        <input type="hidden" asp-for="IdEmpleado" />
        <div class="row">
            <div class="col-12 mb-3">
                <label for="fotoPerfil" class="form-label">Fotografía del empleado</label>
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(Model.FotoPerfil))
                    {
                        <img src="@Model.FotoPerfil" alt="Foto de @Model.NombreEmpleado" class="rounded-circle object-fit-cover" width="72" height="72" />
                    }
                    <input id="fotoPerfil" name="fotoPerfil" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                </div>
                <div class="form-text">Seleccione una imagen para agregarla o reemplazar la actual. Máximo 5 MB.</div>
                <span class="text-danger field-validation-valid" data-valmsg-for="fotoPerfil"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IdentificacionEmpleado" class="form-label"></label>
                <input asp-for="IdentificacionEmpleado" class="form-control" />
                <span asp-validation-for="IdentificacionEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NombreEmpleado" class="form-label"></label>
                <input asp-for="NombreEmpleado" class="form-control" />
                <span asp-validation-for="NombreEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ApellidosEmpleado" class="form-label"></label>
                <input asp-for="ApellidosEmpleado" class="form-control" />
                <span asp-validation-for="ApellidosEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CorreoElectronicoEmpleado" class="form-label"></label>
                <input asp-for="CorreoElectronicoEmpleado" class="form-control" readonly />
                <span asp-validation-for="CorreoElectronicoEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="TelefonoEmpleado" class="form-label"></label>
                <input asp-for="TelefonoEmpleado" class="form-control" />
                <span asp-validation-for="TelefonoEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="SalarioBase" class="form-label"></label>
                <input asp-for="SalarioBase" class="form-control" />
                <span asp-validation-for="SalarioBase" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="FechaInicioEmpleado" class="form-label"></label>
                <input asp-for="FechaInicioEmpleado" type="date" class="form-control" />
                <span asp-validation-for="FechaInicioEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="FechaFinalizacionEmpleado" class="form-label"></label>
                <input asp-for="FechaFinalizacionEmpleado" type="date" class="form-control" />
                <span asp-validation-for="FechaFinalizacionEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label for="estadoGestion" class="form-label">Estado</label>
                <select id="estadoGestion" name="estadoGestion" class="form-select">
                    @{
                        var estadoSeleccionado = ViewData["EstadoGestion"]?.ToString()
                            ?? MultiservicioB.Models.EstadosEmpleado.Obtener(Model);
                    }
                    @if (!esAdministradorPrincipal)
                    {
                    <option value="Pendiente" selected="@(estadoSeleccionado == "Pendiente" ? "selected" : null)">Pendiente</option>
                    }
                    <option value="Activo" selected="@(estadoSeleccionado == "Activo" ? "selected" : null)">Activo</option>
                    @if (!esAdministradorPrincipal)
                    {
                    <option value="Inactivo" selected="@(estadoSeleccionado == "Inactivo" ? "selected" : null)">Inactivo</option>
                    }
                </select>
                <div class="form-text">@(esAdministradorPrincipal ? "La cuenta del administrador principal permanece siempre activa." : "Solo los empleados activos pueden registrar una cuenta e iniciar sesión.")</div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-action-save">Guardar</button>
            <a asp-action="Index" class="btn btn-action-cancel">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
