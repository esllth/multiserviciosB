@model MultiservicioB.Models.Empleado
@{
    ViewData["Title"] = "Editar empleado";
}

<section class="container py-4">
    <h1 class="site-heading">Editar empleado</h1>

    <form asp-action="Edit" method="post" class="mt-3">
        <input type="hidden" asp-for="IdEmpleado" />
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="IdentificacionEmpleado" class="form-label"></label>
                <input asp-for="IdentificacionEmpleado" class="form-control" />
                <span asp-validation-for="IdentificacionEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NombreEmpleado" class="form-label"></label>
                <input asp-for="NombreEmpleado" class="form-control" />
                <span asp-validation-for="NombreEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ApellidosEmpleado" class="form-label"></label>
                <input asp-for="ApellidosEmpleado" class="form-control" />
                <span asp-validation-for="ApellidosEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CorreoElectronicoEmpleado" class="form-label"></label>
                <input asp-for="CorreoElectronicoEmpleado" class="form-control" readonly />
                <span asp-validation-for="CorreoElectronicoEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="TelefonoEmpleado" class="form-label"></label>
                <input asp-for="TelefonoEmpleado" class="form-control" />
                <span asp-validation-for="TelefonoEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="SalarioBase" class="form-label"></label>
                <input asp-for="SalarioBase" class="form-control" />
                <span asp-validation-for="SalarioBase" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="FechaInicioEmpleado" class="form-label"></label>
                <input asp-for="FechaInicioEmpleado" type="date" class="form-control" />
                <span asp-validation-for="FechaInicioEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="FechaFinalizacionEmpleado" class="form-label"></label>
                <input asp-for="FechaFinalizacionEmpleado" type="date" class="form-control" />
                <span asp-validation-for="FechaFinalizacionEmpleado" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3 form-check">
                <input asp-for="EstadoEmpleado" class="form-check-input" />
                <label asp-for="EstadoEmpleado" class="form-check-label"></label>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
