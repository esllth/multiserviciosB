@model IEnumerable<MultiservicioB.Models.Empleado>
@{
    ViewData["Title"] = "Empleados";
}

<div class="idx-page">
    <div class="idx-header">
        <div>
            <h1 class="idx-title">Empleados</h1>
            <p class="idx-sub">@Model.Count() empleado(s) registrado(s)</p>
        </div>
        <a class="btn idx-btn-new" href="@Url.Action("Create")">
            <i class="bi bi-person-plus me-1"></i> Nuevo empleado
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="idx-alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="idx-alert-error">@TempData["ErrorMessage"]</div>
    }

    <div class="idx-card">
        @if (!Model.Any())
        {
            <div class="idx-empty">
                <i class="bi bi-people idx-empty-icon"></i>
                <p class="idx-empty-title">Sin empleados registrados</p>
                <p class="idx-empty-sub">Cree el primer empleado con el botón de arriba.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tablaEmpleados" class="table idx-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Empleado</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th>Cuenta</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var empleado in Model)
                        {
                            var estado = MultiservicioB.Models.EstadosEmpleado.Obtener(empleado);
                            var estadoClass = estado switch
                            {
                                "Activo" => "idx-badge-active",
                                "Pendiente" => "idx-badge-warn",
                                _ => "idx-badge-inactive"
                            };
                            <tr>
                                <td><span class="idx-mono">@empleado.IdentificacionEmpleado</span></td>
                                <td>
                                    <div class="idx-avatar-row">
                                        <span class="idx-avatar">@empleado.NombreEmpleado[0].ToString().ToUpper()</span>
                                        <div>
                                            <span class="idx-name">@empleado.NombreEmpleado @empleado.ApellidosEmpleado</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@empleado.CorreoElectronicoEmpleado" class="idx-link">
                                        @empleado.CorreoElectronicoEmpleado
                                    </a>
                                </td>
                                <td>
                                    <span class="idx-sub-text">
                                        <i class="bi bi-telephone me-1"></i>@empleado.TelefonoEmpleado
                                    </span>
                                </td>
                                <td><span class="idx-badge @estadoClass">@estado</span></td>
                                <td>
                                    <span class="idx-badge @(empleado.TieneUsuario ? "idx-badge-active" : "idx-badge-warn")">
                                        @(empleado.TieneUsuario ? "Registrada" : "Sin registrar")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="idx-actions">
                                        <a class="btn idx-btn-secondary" asp-action="Details" asp-route-id="@empleado.IdEmpleado" title="Ver detalles">
                                            <i class="bi bi-eye me-1"></i>Ver
                                        </a>
                                        <a class="btn idx-btn-edit" asp-action="Edit" asp-route-id="@empleado.IdEmpleado" title="Editar">
                                            <i class="bi bi-pencil me-1"></i>Editar
                                        </a>
                                        @if (estado != MultiservicioB.Models.EstadosEmpleado.Inactivo)
                                        {
                                            <a class="btn idx-btn-danger" asp-action="Delete" asp-route-id="@empleado.IdEmpleado" title="Dar de baja">
                                                <i class="bi bi-person-dash me-1"></i>Dar baja
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/datatables-config.js"></script>
    <script>
        $(document).ready(function () {
            initDataTableSpanish('#tablaEmpleados', {
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });
        });
    </script>
}
