@model IEnumerable<MultiservicioB.Models.Empleado>
@{
    ViewData["Title"] = "Empleados";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="site-heading">Empleados</h1>
        <a class="btn btn-primary" href="@Url.Action("Create")">Nuevo empleado</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Identificación</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Activo</th>
                <th>Acceso</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model ?? Enumerable.Empty<MultiservicioB.Models.Empleado>())
            {
                <tr>
                    <td>@item.IdentificacionEmpleado</td>
                    <td>@item.NombreEmpleado @item.ApellidosEmpleado</td>
                    <td>@item.CorreoElectronicoEmpleado</td>
                    <td>@(item.EstadoEmpleado ? "Sí" : "No")</td>
                    <td>@item.EstadoAcceso</td>
                    <td class="text-nowrap">
                        @if (item.TieneUsuario && item.EstadoAcceso != "Aprobado")
                        {
                            <form asp-action="AprobarAcceso" asp-route-id="@item.IdEmpleado" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Aprobar acceso</button>
                            </form>
                        }
                        @if (item.TieneUsuario && item.EstadoAcceso == "PendienteAprobacion")
                        {
                            <form asp-action="RechazarAcceso" asp-route-id="@item.IdEmpleado" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Rechazar acceso</button>
                            </form>
                        }
                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Details", new { id = item.IdEmpleado })">Ver</a>
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = item.IdEmpleado })">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", new { id = item.IdEmpleado })">Dar baja</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
