@model MultiservicioB.Models.Empleado
@{
    ViewData["Title"] = "Crear empleado";
}

<div class="emp-create-page">

    <div class="emp-page-header">
        <a asp-action="Index" class="emp-back-link">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
        <h1 class="emp-page-title">Nuevo empleado</h1>
    </div>

    <form asp-action="Create" method="post" class="emp-form" novalidate>

        @* Sección 1: Identificación *@
        <div class="emp-card">
            <div class="emp-card-header">
                <span class="emp-card-icon"><i class="bi bi-person-badge"></i></span>
                <div>
                    <h2 class="emp-card-title">Identificación</h2>
                    <p class="emp-card-desc">Ingrese la cédula para autocompletar nombre y apellidos.</p>
                </div>
            </div>
            <div class="row g-3">

                    <div class="col-12 col-md-4">
                        <label asp-for="IdentificacionEmpleado" class="emp-label">
                            <i class="bi bi-credit-card-2-front me-1"></i>Cédula
                        </label>
                        <div class="input-group emp-input-group">
                            <input asp-for="IdentificacionEmpleado" class="form-control emp-input"
                                   id="inputCedula" placeholder="Ej: 305320570" autocomplete="off" />
                            <span class="input-group-text emp-cedula-status" id="buscadorStatus">
                                <span id="buscadorSpinner" class="spinner-border spinner-border-sm d-none text-primary" role="status"></span>
                                <i class="bi bi-check-circle-fill d-none text-success" id="iconoOk"></i>
                                <i class="bi bi-search text-secondary" id="iconoDefault"></i>
                            </span>
                        </div>
                        <div id="cedulaFeedback" class="emp-feedback d-none"></div>
                        <span asp-validation-for="IdentificacionEmpleado" class="emp-error"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="NombreEmpleado" class="emp-label">
                            <i class="bi bi-person me-1"></i>Nombre(s)
                        </label>
                        <input asp-for="NombreEmpleado" class="form-control emp-input" id="inputNombre"
                               placeholder="Autocompletado con cédula" />
                        <span asp-validation-for="NombreEmpleado" class="emp-error"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="ApellidosEmpleado" class="emp-label">
                            <i class="bi bi-person me-1"></i>Apellidos
                        </label>
                        <input asp-for="ApellidosEmpleado" class="form-control emp-input" id="inputApellidos"
                               placeholder="Autocompletado con cédula" />
                        <span asp-validation-for="ApellidosEmpleado" class="emp-error"></span>
                    </div>

                </div>
        </div>

        @* Sección 2: Contacto *@
        <div class="emp-card">
            <div class="emp-card-header">
                <span class="emp-card-icon"><i class="bi bi-envelope"></i></span>
                <div>
                    <h2 class="emp-card-title">Contacto</h2>
                    <p class="emp-card-desc">Correo y teléfono del empleado.</p>
                </div>
            </div>
            <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="CorreoElectronicoEmpleado" class="emp-label">
                            <i class="bi bi-envelope me-1"></i>Correo electrónico
                        </label>
                        <input asp-for="CorreoElectronicoEmpleado" class="form-control emp-input"
                               placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="CorreoElectronicoEmpleado" class="emp-error"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="TelefonoEmpleado" class="emp-label">
                            <i class="bi bi-telephone me-1"></i>Teléfono
                        </label>
                        <input asp-for="TelefonoEmpleado" class="form-control emp-input"
                               placeholder="8888-8888" />
                        <span asp-validation-for="TelefonoEmpleado" class="emp-error"></span>
                    </div>

                </div>
        </div>

        @* Sección 3: Datos laborales *@
        <div class="emp-card">
            <div class="emp-card-header">
                <span class="emp-card-icon"><i class="bi bi-briefcase"></i></span>
                <div>
                    <h2 class="emp-card-title">Datos laborales</h2>
                    <p class="emp-card-desc">Salario y fecha de ingreso del empleado.</p>
                </div>
            </div>
            <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="SalarioBase" class="emp-label">
                            <i class="bi bi-cash-coin me-1"></i>Salario base (₡)
                        </label>
                        <input asp-for="SalarioBase" class="form-control emp-input"
                               placeholder="Ej: 550000" />
                        <span asp-validation-for="SalarioBase" class="emp-error"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="FechaInicioEmpleado" class="emp-label">
                            <i class="bi bi-calendar-event me-1"></i>Fecha de inicio
                        </label>
                        <input asp-for="FechaInicioEmpleado" type="date" class="form-control emp-input" />
                        <span asp-validation-for="FechaInicioEmpleado" class="emp-error"></span>
                    </div>

                </div>
        </div>

        @* Acciones *@
        <div class="emp-actions">
            <a asp-action="Index" class="btn emp-btn-cancel">
                <i class="bi bi-x-lg me-1"></i>Cancelar
            </a>
            <button type="submit" class="btn emp-btn-submit">
                <i class="bi bi-person-plus me-1"></i>Crear empleado
            </button>
        </div>

    </form>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const inputCedula = document.getElementById('inputCedula');
            const inputNombre = document.getElementById('inputNombre');
            const inputApells = document.getElementById('inputApellidos');
            const spinner     = document.getElementById('buscadorSpinner');
            const iconoOk     = document.getElementById('iconoOk');
            const iconoDef    = document.getElementById('iconoDefault');
            const feedback    = document.getElementById('cedulaFeedback');

            function setEstado(estado) {
                spinner.classList.add('d-none');
                iconoOk.classList.add('d-none');
                iconoDef.classList.add('d-none');
                if (estado === 'loading')   spinner.classList.remove('d-none');
                else if (estado === 'ok')   iconoOk.classList.remove('d-none');
                else                        iconoDef.classList.remove('d-none');
            }

            function mostrarFeedback(msg, tipo) {
                feedback.textContent = msg;
                feedback.className = `emp-feedback ${tipo}`;
            }

            function toTitleCase(str) {
                return str.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
            }

            function parsearNombre(nombreCompleto) {
                const partes = nombreCompleto.trim().split(/\s+/);
                if (partes.length < 3) return { nombres: partes.join(' '), apellidos: '' };
                return {
                    apellidos: partes.slice(-2).join(' '),
                    nombres:   partes.slice(0, -2).join(' ')
                };
            }

            async function buscarCedula() {
                const cedula = inputCedula.value.trim();
                if (!cedula) return;

                setEstado('loading');
                feedback.className = 'emp-feedback d-none';

                try {
                    const res = await fetch(`https://api.hacienda.go.cr/fe/ae?identificacion=${encodeURIComponent(cedula)}`);

                    if (!res.ok) {
                        setEstado('error');
                        mostrarFeedback('No se encontró ningún contribuyente con esa cédula.', 'emp-feedback-error');
                        return;
                    }

                    const data = await res.json();
                    const nombreCompleto = (data.nombre ?? '').trim();

                    if (!nombreCompleto) {
                        setEstado('error');
                        mostrarFeedback('La API no devolvió un nombre.', 'emp-feedback-warning');
                        return;
                    }

                    const { nombres, apellidos } = parsearNombre(nombreCompleto);
                    inputNombre.value = toTitleCase(nombres);
                    inputApells.value = toTitleCase(apellidos);

                    setEstado('ok');
                    mostrarFeedback('✓ Datos obtenidos de Hacienda', 'emp-feedback-ok');

                } catch (err) {
                    setEstado('error');
                    mostrarFeedback('Error al consultar el API de Hacienda. Verifique su conexión.', 'emp-feedback-error');
                    console.error(err);
                }
            }

            inputCedula.addEventListener('blur', buscarCedula);
        })();
    </script>
}
