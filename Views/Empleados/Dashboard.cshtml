@{
    ViewData["Title"] = "Dashboard";
    var eventosAsignados = ViewBag.EventosAsignados as IEnumerable<MultiservicioB.ViewModels.EventoCalendarioClienteViewModel>
        ?? Enumerable.Empty<MultiservicioB.ViewModels.EventoCalendarioClienteViewModel>();
}

<section class="container py-5 dashboard-page">
    <div class="dashboard-heading">
        <span class="dashboard-eyebrow">Panel principal</span>
        <h1 class="site-heading">Bienvenido a Multiservicios B</h1>
        <p>Seleccione una opción para consultar sus asignaciones y gestionar materiales.</p>
    </div>

    @if (eventosAsignados.Any())
    {
        <section class="admin-work-alert mb-4" aria-labelledby="employee-upcoming-events-title">
            <div class="admin-work-alert-head">
                <span class="admin-work-alert-icon"><i class="bi bi-calendar-event"></i></span>
                <div>
                    <span class="dashboard-eyebrow">Avisos importantes</span>
                    <h2 id="employee-upcoming-events-title">Compromisos asignados</h2>
                </div>
                <a asp-controller="Tecnicos" asp-action="Index" class="btn btn-action-view ms-auto"><i class="bi bi-calendar-week"></i> Ver eventos</a>
            </div>
            <div class="admin-work-alert-list">
                @foreach (var evento in eventosAsignados)
                {
                    <div class="admin-work-alert-item">
                        <div>
                            <strong>@evento.FechaCompromiso.ToString("dd/MM/yyyy hh:mm tt") - Orden #@evento.IdOrden</strong>
                            <p>@evento.TipoServicio</p>
                            <small>@evento.EstadoOrden</small>
                        </div>
                        <div class="admin-work-alert-actions">
                            <a asp-controller="Tecnicos" asp-action="Detalle" asp-route-id="@evento.IdOrden" class="btn btn-action-view btn-sm"><i class="bi bi-eye"></i> Ver</a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <div class="row g-4 dashboard-grid">
        <div class="col-md-6 col-xl-4">
            <a asp-controller="Empleados" asp-action="MiPerfil" class="dashboard-tile dashboard-tone-1">
                <i class="bi bi-person-badge"></i>
                <span>Mi perfil</span>
                <small>Consulte su información personal y laboral</small>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-controller="Tecnicos" asp-action="Index" class="dashboard-tile dashboard-tone-3">
                <i class="bi bi-clipboard-check"></i>
                <span>Mis órdenes</span>
                <small>Consulte las órdenes de servicio asignadas</small>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-controller="Materiales" asp-action="Index" class="dashboard-tile dashboard-tone-6">
                <i class="bi bi-box-seam"></i>
                <span>Materiales</span>
                <small>Consulte y agregue materiales al inventario</small>
            </a>
        </div>
    </div>
</section>
