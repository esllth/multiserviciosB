@model MultiservicioB.DTOs.ProyectoFabricacionDTO

@{
    ViewData["Title"] = "Crear Proyecto de Fabricación";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Crear Nuevo Proyecto de Fabricación</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Crear" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="NombreProyecto" class="form-label"></label>
                            <input asp-for="NombreProyecto" class="form-control" />
                            <span asp-validation-for="NombreProyecto" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label"></label>
                            <input asp-for="ClienteId" class="form-control" type="number" />
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                            <small class="form-text text-muted">Ingrese el ID del cliente</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaInicioEstimada" class="form-label"></label>
                                <input asp-for="FechaInicioEstimada" class="form-control" type="date" />
                                <span asp-validation-for="FechaInicioEstimada" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaFinEstimada" class="form-label"></label>
                                <input asp-for="FechaFinEstimada" class="form-control" type="date" />
                                <span asp-validation-for="FechaFinEstimada" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CostoEstimado" class="form-label"></label>
                                <input asp-for="CostoEstimado" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="CostoEstimado" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Estado" class="form-label"></label>
                                <select asp-for="Estado" class="form-select">
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="EnDiseño">En Diseño</option>
                                    <option value="CotizacionPendiente">Cotización Pendiente</option>
                                    <option value="Aprobado">Aprobado</option>
                                    <option value="EnProduccion">En Producción</option>
                                    <option value="Finalizado">Finalizado</option>
                                    <option value="Cancelado">Cancelado</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-action-cancel">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-action-save">
                                <i class="bi bi-save"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
