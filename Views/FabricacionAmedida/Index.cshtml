@model IEnumerable<MultiservicioB.DTOs.ProyectoFabricacionDTO>

@{
    ViewData["Title"] = "Fabricación a Medida";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Proyectos de Fabricación a Medida</h1>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Crear" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo Proyecto
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Estado</th>
                            @if (User.IsInRole("Administrador"))
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proyecto in Model)
                        {
                            <tr>
                                <td>@proyecto.NombreCliente</td>
                                <td>@proyecto.Descripcion</td>
                                <td>@proyecto.FechaInicio?.ToString("dd/MM/yyyy")</td>
                                <td>@proyecto.FechaFin?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (proyecto.Estado == "Completado")
                                    {
                                        <span class="badge bg-success">@proyecto.Estado</span>
                                    }
                                    else if (proyecto.Estado == "En Progreso")
                                    {
                                        <span class="badge bg-primary">@proyecto.Estado</span>
                                    }
                                    else if (proyecto.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning">@proyecto.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@proyecto.Estado</span>
                                    }
                                </td>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <td>
                                        <a asp-action="Editar" asp-route-id="@proyecto.IdProyecto" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a asp-action="Eliminar" asp-route-id="@proyecto.IdProyecto" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
