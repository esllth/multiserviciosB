@model MultiservicioB.ViewModels.FabricacionAmedidaIndexViewModel

@{
    ViewData["Title"] = "Fabricación a Medida";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Proyectos de Fabricación a Medida</h1>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Cliente"))
            {
                <a asp-action="ChatCotizacion" class="btn btn-action-create">
                    <i class="bi bi-chat-dots"></i> Cotizar con asistente
                </a>
            }
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Crear" class="btn btn-action-create">
                    <i class="bi bi-plus-circle"></i> Nuevo Proyecto
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header"><h2 class="h5 mb-0">Cotizaciones de fabricación a medida</h2></div>
        <div class="card-body">
            @if (Model.Cotizaciones.Any())
            {
                <div class="row g-3">
                    @foreach (var cotizacion in Model.Cotizaciones)
                    {
                        <div class="col-12 col-lg-6">
                            <article class="card h-100 border">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between gap-2 mb-2">
                                        <h3 class="h6 mb-0">Cotización #@cotizacion.IdCotizacion</h3>
                                        <span class="idx-badge @EstadoBadge.Cotizacion(cotizacion.Estado)">@cotizacion.Estado</span>
                                    </div>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <p class="mb-1"><strong>Cliente:</strong> @cotizacion.Cliente</p>
                                    }
                                    <p class="mb-1"><strong>Fecha:</strong> @cotizacion.FechaSolicitud?.ToString("dd/MM/yyyy")</p>
                                    <p class="mb-1"><strong>Descripción:</strong> @cotizacion.Descripcion</p>
                                    @if (cotizacion.MontoPresupuesto.HasValue)
                                    {
                                        <p class="mb-3"><strong>Presupuesto:</strong> ₡@cotizacion.MontoPresupuesto.Value.ToString("N2")</p>
                                    }
                                    <a asp-controller="Cotizaciones" asp-action="Detalle" asp-route-id="@cotizacion.IdCotizacion" class="btn btn-sm btn-action-view">Ver cotización</a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Aún no hay cotizaciones de fabricación a medida.</p>
            }
        </div>
    </div>

</section>

