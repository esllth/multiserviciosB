@model IEnumerable<MultiservicioB.DTOs.ProyectoFabricacionDTO>

@{
    ViewData["Title"] = "Fabricación a Medida";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Proyectos de Fabricación a Medida</h1>
        @if (User.IsInRole("Administrador"))
        {
            <a asp-action="Crear" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo Proyecto
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaProyectos" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Proyecto</th>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th>Fecha Inicio Est.</th>
                            <th>Fecha Fin Est.</th>
                            <th>Fecha Inicio Real</th>
                            <th>Fecha Fin Real</th>
                            <th>Costo Est.</th>
                            <th>Costo Real</th>
                            <th>Estado</th>
                            <th>Diseño</th>
                            @if (User.IsInRole("Administrador"))
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proyecto in Model)
                        {
                            <tr>
                                <td><strong>@proyecto.NombreProyecto</strong></td>
                                <td>@proyecto.NombreCliente</td>
                                <td>@(proyecto.Descripcion?.Length > 50 ? proyecto.Descripcion.Substring(0, 50) + "..." : proyecto.Descripcion)</td>
                                <td>@proyecto.FechaInicioEstimada?.ToString("dd/MM/yyyy")</td>
                                <td>@proyecto.FechaFinEstimada?.ToString("dd/MM/yyyy")</td>
                                <td>@proyecto.FechaInicioReal?.ToString("dd/MM/yyyy")</td>
                                <td>@proyecto.FechaFinReal?.ToString("dd/MM/yyyy")</td>
                                <td>₡@proyecto.CostoEstimado?.ToString("N2")</td>
                                <td>₡@proyecto.CostoReal?.ToString("N2")</td>
                                <td>
                                    @if (proyecto.Estado == "Finalizado")
                                    {
                                        <span class="badge bg-success">@proyecto.Estado</span>
                                    }
                                    else if (proyecto.Estado == "EnProduccion")
                                    {
                                        <span class="badge bg-primary">En Producción</span>
                                    }
                                    else if (proyecto.Estado == "Aprobado")
                                    {
                                        <span class="badge bg-info">@proyecto.Estado</span>
                                    }
                                    else if (proyecto.Estado == "EnDiseño")
                                    {
                                        <span class="badge bg-warning text-dark">En Diseño</span>
                                    }
                                    else if (proyecto.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-secondary">@proyecto.Estado</span>
                                    }
                                    else if (proyecto.Estado == "Cancelado")
                                    {
                                        <span class="badge bg-danger">@proyecto.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@proyecto.Estado</span>
                                    }
                                </td>
                                <td>
                                    @if (proyecto.DiseñoAprobado)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Aprobado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">
                                            <i class="bi bi-clock"></i> Pendiente
                                        </span>
                                    }
                                </td>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <td class="text-nowrap">
                                        <a asp-action="Detalle" asp-route-id="@proyecto.IdProyecto" class="btn btn-sm btn-info" title="Ver detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Editar" asp-route-id="@proyecto.IdProyecto" class="btn btn-sm btn-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Eliminar" asp-route-id="@proyecto.IdProyecto" class="btn btn-sm btn-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/datatables-config.js"></script>
    <script>
        $(document).ready(function () {
            initDataTableSpanish('#tablaProyectos', {
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: @(User.IsInRole("Administrador") ? "-1" : "[]") }
                ]
            });
        });
    </script>
}
