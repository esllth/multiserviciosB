@model MultiservicioB.ViewModels.CalendarioClienteViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Calendario de citas";
    var cultura = CultureInfo.GetCultureInfo("es-MX");
    var primerDia = Model.Mes;
    var inicioCuadricula = primerDia.AddDays(-(((int)primerDia.DayOfWeek + 6) % 7));
    var eventosPorDia = Model.Eventos.GroupBy(e => e.FechaCompromiso.Date).ToDictionary(g => g.Key, g => g.ToList());
}

<section class="container py-5 dashboard-page">
    <div class="dashboard-heading">
        <span class="dashboard-eyebrow">Mis servicios</span>
        <h1 class="site-heading">Calendario de citas</h1>
        <p>Consulte las fechas confirmadas de sus servicios.</p>
        <a asp-action="Dashboard" class="btn btn-action-cancel mt-2"><i class="bi bi-arrow-left"></i> Volver al dashboard</a>
    </div>

    <section class="client-calendar" aria-labelledby="client-calendar-title">
        <div class="client-calendar-header">
            <div>
                <span class="dashboard-eyebrow">Mis servicios</span>
                <h2 id="client-calendar-title">Calendario de citas</h2>
            </div>
            <div class="client-calendar-navigation">
                <a asp-action="Index" asp-route-anio="@Model.Mes.AddMonths(-1).Year" asp-route-mes="@Model.Mes.AddMonths(-1).Month" class="btn btn-action-view" aria-label="Mes anterior"><i class="bi bi-chevron-left"></i></a>
                <strong>@Model.Mes.ToString("MMMM yyyy", cultura)</strong>
                <a asp-action="Index" asp-route-anio="@Model.Mes.AddMonths(1).Year" asp-route-mes="@Model.Mes.AddMonths(1).Month" class="btn btn-action-view" aria-label="Mes siguiente"><i class="bi bi-chevron-right"></i></a>
            </div>
        </div>

        <div class="client-calendar-grid" role="grid" aria-label="Citas de @Model.Mes.ToString("MMMM yyyy", cultura)">
            @foreach (var diaSemana in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" })
            {
                <div class="client-calendar-weekday" role="columnheader">@diaSemana</div>
            }
            @for (var i = 0; i < 42; i++)
            {
                var dia = inicioCuadricula.AddDays(i);
                var tieneEventos = eventosPorDia.TryGetValue(dia.Date, out var eventosDia);
                <div class="client-calendar-day @(dia.Month == Model.Mes.Month ? "" : "is-outside-month") @(dia.Date == DateTime.Today ? "is-today" : "")" role="gridcell">
                    <span class="client-calendar-date">@dia.Day</span>
                    @if (tieneEventos)
                    {
                        foreach (var evento in eventosDia!)
                        {
                            <a asp-controller="Tecnicos" asp-action="Detalle" asp-route-id="@evento.IdOrden" class="client-calendar-event" title="@evento.TipoServicio · @evento.FechaCompromiso.ToString("hh:mm tt")">
                                <span>@evento.FechaCompromiso.ToString("hh:mm tt")</span>
                                <strong>@evento.TipoServicio</strong>
                            </a>
                        }
                    }
                </div>
            }
        </div>
        @if (!Model.Eventos.Any())
        {
            <p class="client-calendar-empty">No hay citas confirmadas para este mes.</p>
        }
    </section>

</section>
