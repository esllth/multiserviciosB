@{
    ViewData["Title"] = "Portal cliente";
}

<section class="container py-5 dashboard-page">
    <div class="dashboard-heading">
        <span class="dashboard-eyebrow">Panel principal</span>
        <h1 class="site-heading">Portal cliente</h1>
        <p>Gestione sus solicitudes y consulte el seguimiento de sus servicios.</p>
    </div>

    <div class="row g-4 mt-2 dashboard-grid">
        <div class="col-md-6">
            <a asp-controller="Cotizaciones" asp-action="Index" class="dashboard-tile dashboard-tone-1">
                <i class="bi bi-file-earmark-text"></i>
                <span>Cotizaciones</span>
                <small>Solicite cotizaciones y responda las evaluaciones de administración.</small>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-controller="Tecnicos" asp-action="Index" class="dashboard-tile dashboard-tone-6">
                <i class="bi bi-clipboard-check"></i>
                <span>Órdenes de servicio</span>
                <small>Consulte el estado y detalle de sus servicios registrados.</small>
            </a>
        </div>
    </div>
</section>
