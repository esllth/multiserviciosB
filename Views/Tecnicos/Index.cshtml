@model IEnumerable<MultiservicioB.DTOs.OrdenServicioDTO>

@{
    ViewData["Title"] = "Órdenes de Servicio - Técnico";
}

<section class="container py-5 dashboard-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Mis Órdenes de Servicio</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="estadoOrdenId" class="form-label">Estado de la orden</label>
                    <select id="estadoOrdenId" name="estadoOrdenId" asp-items="ViewBag.EstadosOrden" class="form-select">
                        <option value="">Todos los estados</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="cliente" class="form-label">Cliente</label>
                    <input id="cliente" name="cliente" value="@ViewBag.Cliente" class="form-control" placeholder="Nombre o identificación" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4 dashboard-metrics">
        <div class="col-md-3">
            <div class="card text-center dashboard-metric metric-pending">
                <div class="card-body">
                    <h3>@Model.Count(o => o.NombreEstado == "Pendiente")</h3>
                    <p class="mb-0">Pendientes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center dashboard-metric metric-progress">
                <div class="card-body">
                    <h3>@Model.Count(o => o.NombreEstado == "En Progreso")</h3>
                    <p class="mb-0">En Progreso</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center dashboard-metric metric-complete">
                <div class="card-body">
                    <h3>@Model.Count(o => o.NombreEstado == "Completada")</h3>
                    <p class="mb-0">Completadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center dashboard-metric metric-total">
                <div class="card-body">
                    <h3>@Model.Count()</h3>
                    <p class="mb-0">Total</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaOrdenes" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th>Fecha Creación</th>
                            <th>Compromiso</th>
                            <th>Fecha Llegada</th>
                            <th>Fecha Inicio</th>
                            <th>Fecha Fin</th>
                            <th>Estado</th>
                            <th>Técnico</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var orden in Model.OrderByDescending(o => o.FechaCreacion))
                        {
                            <tr>
                                <td><strong>#@orden.IdOrden</strong></td>
                                <td>@orden.NombreCliente</td>
                                <td>@(orden.DescripcionServicio?.Length > 40 ? orden.DescripcionServicio.Substring(0, 40) + "..." : orden.DescripcionServicio)</td>
                                <td>@orden.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td>
                                    @if (orden.FechaCompromiso.HasValue)
                                    {
                                        <span>@orden.FechaCompromiso.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                        @if (orden.CompromisoConfirmado)
                                        {
                                            <span class="badge bg-success d-block mt-1">Confirmado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning d-block mt-1">Pendiente</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (orden.FechaLlegadaSitio.HasValue)
                                    {
                                        <span>@orden.FechaLlegadaSitio.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (orden.FechaInicio.HasValue)
                                    {
                                        <span>@orden.FechaInicio.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (orden.FechaFin.HasValue)
                                    {
                                        <span>@orden.FechaFin.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (orden.NombreEstado == "Completada")
                                    {
                                        <span class="badge bg-success">@orden.NombreEstado</span>
                                    }
                                    else if (orden.NombreEstado == "En Progreso" || orden.NombreEstado == "EnProgreso")
                                    {
                                        <span class="badge bg-info">En Progreso</span>
                                    }
                                    else if (orden.NombreEstado == "Pendiente")
                                    {
                                        <span class="badge bg-warning">@orden.NombreEstado</span>
                                    }
                                    else if (orden.NombreEstado == "Cancelada")
                                    {
                                        <span class="badge bg-danger">@orden.NombreEstado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@orden.NombreEstado</span>
                                    }
                                </td>
                                <td>@orden.NombreTecnico</td>
                                <td class="text-nowrap">
                                    <a asp-action="Detalle" asp-route-id="@orden.IdOrden" class="btn btn-sm btn-info text-white" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Administrar" asp-route-id="@orden.IdOrden" class="btn btn-sm btn-primary" title="Administrar">
                                            <i class="bi bi-gear"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("Administrador") && orden.EmpleadoId.HasValue && orden.NombreEstado == "Pendiente")
                                    {
                                        <form asp-action="IniciarOrden" asp-route-id="@orden.IdOrden" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success" title="Iniciar orden">
                                                <i class="bi bi-play"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (User.IsInRole("Administrador") && (orden.NombreEstado == "En Progreso" || orden.NombreEstado == "EnProgreso"))
                                    {
                                        <form asp-action="FinalizarOrden" asp-route-id="@orden.IdOrden" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success" title="Finalizar orden">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (User.IsInRole("Empleado") && (orden.NombreEstado == "En Progreso" || orden.NombreEstado == "EnProgreso"))
                                    {
                                        @if (orden.AvisoTrabajoCompletadoEnviado)
                                        {
                                            <button type="button" class="btn btn-sm btn-success" title="Aviso enviado" disabled>
                                                <i class="bi bi-check-circle"></i> Aviso enviado
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="ReportarTrabajoCompletado" asp-route-id="@orden.IdOrden" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-warning" title="Avisar trabajo completado">
                                                    <i class="bi bi-send-check"></i>
                                                </button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/datatables-config.js"></script>
    <script>
        $(document).ready(function () {
            initDataTableSpanish('#tablaOrdenes', {
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: -1 }
                ]
            });
        });
    </script>
}
