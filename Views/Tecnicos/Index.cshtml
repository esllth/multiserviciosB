@model IEnumerable<MultiservicioB.DTOs.OrdenServicioDTO>

@{
    ViewData["Title"] = "Órdenes de Servicio - Técnico";
}

<section class="container py-5 dashboard-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Mis Órdenes de Servicio</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="estadoOrdenId" class="form-label">Estado de la orden</label>
                    <select id="estadoOrdenId" name="estadoOrdenId" asp-items="ViewBag.EstadosOrden" class="form-select">
                        <option value="">Todos los estados</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="cliente" class="form-label">Cliente</label>
                    <input id="cliente" name="cliente" value="@ViewBag.Cliente" class="form-control" placeholder="Nombre o identificación" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4 dashboard-metrics">
        <div class="col-md-3">
            <div class="card text-center dashboard-metric dashboard-tone-1">
                <div class="card-body">
                    <h3>@Model.Count(o => o.NombreEstado == "Pendiente")</h3>
                    <p class="mb-0">Pendientes</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center dashboard-metric dashboard-tone-2">
                <div class="card-body">
                    <h3>@Model.Count(o => o.NombreEstado == "En Progreso")</h3>
                    <p class="mb-0">En Progreso</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center dashboard-metric dashboard-tone-4">
                <div class="card-body">
                    <h3>@Model.Count(o => o.NombreEstado == "Completada")</h3>
                    <p class="mb-0">Completadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center dashboard-metric dashboard-tone-6">
                <div class="card-body">
                    <h3>@Model.Count()</h3>
                    <p class="mb-0">Total</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th>Fecha Creación</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var orden in Model.OrderByDescending(o => o.FechaCreacion))
                        {
                            <tr>
                                <td>@orden.IdOrden</td>
                                <td>@orden.NombreCliente</td>
                                <td>@orden.DescripcionServicio</td>
                                <td>@orden.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (orden.NombreEstado == "Completada")
                                    {
                                        <span class="badge bg-success">@orden.NombreEstado</span>
                                    }
                                    else if (orden.NombreEstado == "En Progreso")
                                    {
                                        <span class="badge bg-info">@orden.NombreEstado</span>
                                    }
                                    else if (orden.NombreEstado == "Pendiente")
                                    {
                                        <span class="badge bg-warning">@orden.NombreEstado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@orden.NombreEstado</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Detalle" asp-route-id="@orden.IdOrden" class="btn btn-sm btn-info text-white">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Administrar" asp-route-id="@orden.IdOrden" class="btn btn-sm btn-outline-primary">Administrar</a>
                                    }
                                    @if (User.IsInRole("Administrador") && orden.EmpleadoId.HasValue && orden.NombreEstado == "Pendiente")
                                    {
                                        <form asp-action="IniciarOrden" asp-route-id="@orden.IdOrden" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-play"></i> Iniciar
                                            </button>
                                        </form>
                                    }
                                    @if (User.IsInRole("Administrador") && orden.NombreEstado == "En Progreso")
                                    {
                                        <form asp-action="FinalizarOrden" asp-route-id="@orden.IdOrden" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-circle"></i> Finalizar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
