@model MultiservicioB.DTOs.OrdenServicioDTO

@{
    ViewData["Title"] = "Crear Orden de Servicio";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Crear Nueva Orden de Servicio</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Crear" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="CotizacionId" class="form-label"></label>
                            <input asp-for="CotizacionId" class="form-control" type="number" />
                            <span asp-validation-for="CotizacionId" class="text-danger"></span>
                            <small class="form-text text-muted">ID de la cotización aprobada</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label"></label>
                            <input asp-for="ClienteId" class="form-control" type="number" />
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmpleadoId" class="form-label"></label>
                            <input asp-for="EmpleadoId" class="form-control" type="number" />
                            <span asp-validation-for="EmpleadoId" class="text-danger"></span>
                            <small class="form-text text-muted">ID del técnico asignado</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EstadoOrdenId" class="form-label"></label>
                            <select asp-for="EstadoOrdenId" class="form-select">
                                <option value="1">Pendiente</option>
                                <option value="2">En Progreso</option>
                                <option value="3">Completada</option>
                                <option value="4">Cancelada</option>
                            </select>
                            <span asp-validation-for="EstadoOrdenId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaInicio" class="form-label"></label>
                                <input asp-for="FechaInicio" class="form-control" type="datetime-local" />
                                <span asp-validation-for="FechaInicio" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaFin" class="form-label"></label>
                                <input asp-for="FechaFin" class="form-control" type="datetime-local" />
                                <span asp-validation-for="FechaFin" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
