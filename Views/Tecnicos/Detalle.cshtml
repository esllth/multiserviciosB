@model MultiservicioB.DTOs.OrdenServicioDTO
@using System.Globalization
@using MultiservicioB.Models

@{
    ViewData["Title"] = "Detalle de Orden";
    var culturaCr = CultureInfo.GetCultureInfo("es-CR");
    var adelanto = Model.MontoPresupuesto.HasValue && Model.PorcentajeAdelanto.HasValue
        ? Model.MontoPresupuesto.Value * Model.PorcentajeAdelanto.Value / 100m
        : (decimal?)null;
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Detalle de Orden de Servicio #@Model.IdOrden</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.AvisoTrabajoCompletadoEnviado && (Model.NombreEstado == "En Progreso" || Model.NombreEstado == "EnProgreso"))
    {
        <div class="alert alert-success" role="alert">
            <strong>Trabajo completado por tecnico.</strong>
            <span>La orden tiene un aviso pendiente para cierre administrativo.</span>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h4>Información General</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID Orden</dt>
                        <dd class="col-sm-8">@Model.IdOrden</dd>

                        <dt class="col-sm-4">Cliente</dt>
                        <dd class="col-sm-8">@Model.NombreCliente</dd>

                        <dt class="col-sm-4">Técnico Asignado</dt>
                        <dd class="col-sm-8">@(Model.NombreTecnico ?? "Sin asignar")</dd>

                        <dt class="col-sm-4">Descripción</dt>
                        <dd class="col-sm-8">@Model.DescripcionServicio</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            @if (Model.NombreEstado == "Completada")
                            {
                                <span class="badge bg-success">@Model.NombreEstado</span>
                            }
                            else if (Model.NombreEstado == "En Progreso")
                            {
                                <span class="badge bg-info">@Model.NombreEstado</span>
                            }
                            else if (Model.NombreEstado == "Pendiente")
                            {
                                <span class="badge bg-warning">@Model.NombreEstado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.NombreEstado</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Fecha de Creación</dt>
                        <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")</dd>

                        @if (Model.FechaCompromiso.HasValue)
                        {
                            <dt class="col-sm-4">Fecha de compromiso</dt>
                            <dd class="col-sm-8">
                                @Model.FechaCompromiso.Value.ToString("dd/MM/yyyy hh:mm tt")
                                @if (Model.CompromisoConfirmado)
                                {
                                    <span class="badge bg-success ms-2">Confirmado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning ms-2">Pendiente de confirmacion</span>
                                }
                            </dd>
                        }

                        @if (Model.MontoPresupuesto.HasValue || !string.IsNullOrWhiteSpace(Model.FormaPagoAceptada))
                        {
                            <dt class="col-sm-4">Condicion de pago aceptada</dt>
                            <dd class="col-sm-8">
                                @if (Model.FormaPagoAceptada == "Completo")
                                {
                                    <span>El cliente confirmo pago completo por adelantado.</span>
                                }
                                else if (Model.FormaPagoAceptada == "AdelantoSaldo")
                                {
                                    <span>El cliente confirmo pago del adelanto acordado y saldo final pendiente.</span>
                                }
                                else
                                {
                                    <span>Pendiente de confirmacion del cliente.</span>
                                }

                                @if (Model.MontoPresupuesto.HasValue)
                                {
                                    <div class="mt-1">
                                        Monto cotizado: CRC @Model.MontoPresupuesto.Value.ToString("N2", culturaCr)
                                    </div>
                                }

                                @if (Model.RequiereAdelanto && Model.PorcentajeAdelanto.HasValue && adelanto.HasValue)
                                {
                                    <div>
                                        Adelanto solicitado: @Model.PorcentajeAdelanto% - CRC @adelanto.Value.ToString("N2", culturaCr)
                                    </div>
                                }
                            </dd>
                        }

                        @if (Model.UsarDireccionPerfil && !string.IsNullOrWhiteSpace(Model.DireccionServicio))
                        {
                            <dt class="col-sm-4">Ubicacion del servicio</dt>
                            <dd class="col-sm-8">
                                <div>@Model.DireccionServicio</div>
                                @if (!string.IsNullOrWhiteSpace(Model.GoogleMapsUrl))
                                {
                                    <a href="@Model.GoogleMapsUrl" target="_blank" rel="noopener" class="btn btn-outline-success btn-sm mt-2">
                                        <i class="bi bi-geo-alt"></i> Ver en Google Maps
                                    </a>
                                }
                            </dd>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.EnlaceWaze))
                        {
                            <dt class="col-sm-4">Ubicacion del servicio</dt>
                            <dd class="col-sm-8">
                                <a href="@Model.EnlaceWaze" target="_blank" rel="noopener" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-geo-alt"></i> Abrir enlace de Waze
                                </a>
                            </dd>
                        }

                        @if (Model.FechaAvisoTrabajoCompletado.HasValue)
                        {
                            <dt class="col-sm-4">Marcado como completado</dt>
                            <dd class="col-sm-8">@Model.FechaAvisoTrabajoCompletado.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>
                        }

                        @if (Model.FechaInicio.HasValue)
                        {
                            <dt class="col-sm-4">Fecha de Inicio</dt>
                            <dd class="col-sm-8">@Model.FechaInicio.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>
                        }

                        @if (Model.FechaFin.HasValue)
                        {
                            <dt class="col-sm-4">Fecha de Finalización</dt>
                            <dd class="col-sm-8">@Model.FechaFin.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-8 order-md-3">
            <div class="card mb-4">
                <div class="card-header">
                    <h4>Evidencia fotográfica</h4>
                </div>
                <div class="card-body">
                    @if (Model.RequiereFotosObligatorias)
                    {
                        <div class="alert @(Model.PuedeFinalizarse ? "alert-success" : "alert-warning")">
                            <strong>Requisito de cierre:</strong>
                            se requiere al menos una foto inicial y una foto final para cerrar la orden.
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge @(Model.TieneFotosInicio ? "bg-success" : "bg-secondary")">
                            Inicial: @(Model.TieneFotosInicio ? "completa" : "pendiente")
                        </span>
                        <span class="badge @(Model.TieneFotosFin ? "bg-success" : "bg-secondary")">
                            Final: @(Model.TieneFotosFin ? "completa" : "pendiente")
                        </span>
                    </div>

                    @if (User.IsInRole("Empleado") || User.IsInRole("Administrador"))
                    {
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <form asp-action="AdjuntarEvidencia" asp-route-id="@Model.IdOrden" method="post" enctype="multipart/form-data" class="border rounded p-3 h-100">
                                    <input type="hidden" name="tipoFoto" value="Inicial" />
                                    <label class="form-label fw-bold">Adjuntar evidencia inicial</label>
                                    <input type="file" name="archivos" class="form-control mb-2" accept="image/jpeg,image/png,image/webp" multiple />
                                    <textarea name="descripcion" class="form-control mb-2" rows="2" placeholder="Descripción opcional"></textarea>
                                    <button type="submit" class="btn btn-outline-primary w-100">
                                        <i class="bi bi-camera"></i> Subir inicial
                                    </button>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <form asp-action="AdjuntarEvidencia" asp-route-id="@Model.IdOrden" method="post" enctype="multipart/form-data" class="border rounded p-3 h-100">
                                    <input type="hidden" name="tipoFoto" value="Final" />
                                    <label class="form-label fw-bold">Adjuntar evidencia final</label>
                                    <input type="file" name="archivos" class="form-control mb-2" accept="image/jpeg,image/png,image/webp" multiple />
                                    <textarea name="descripcion" class="form-control mb-2" rows="2" placeholder="Descripción opcional"></textarea>
                                    <button type="submit" class="btn btn-outline-success w-100">
                                        <i class="bi bi-camera-fill"></i> Subir final
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    @if (Model.Fotos.Any())
                    {
                        <div class="row g-3">
                            @foreach (var foto in Model.Fotos)
                            {
                                <div class="col-sm-6 col-lg-4">
                                    <a asp-action="Evidencia" asp-route-id="@foto.IdFotoOrden" target="_blank" rel="noopener" class="text-decoration-none">
                                        <img src="@Url.Action("Evidencia", new { id = foto.IdFotoOrden })"
                                             alt="@foto.NombreOriginal"
                                             class="img-fluid rounded border"
                                             loading="lazy" />
                                    </a>
                                    <div class="small mt-2">
                                        <span class="badge @(foto.TipoFoto == "Inicial" ? "bg-primary" : "bg-success")">@foto.TipoFoto</span>
                                        <div>@foto.FechaCarga.ToString("dd/MM/yyyy hh:mm tt")</div>
                                        @if (!string.IsNullOrWhiteSpace(foto.Descripcion))
                                        {
                                            <div class="text-muted">@foto.Descripcion</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Todavía no hay evidencia fotográfica adjunta.</p>
                    }
                </div>
            </div>
        </div>

        @{
            var documentos = ViewBag.Documentos as List<MultiservicioB.Models.DocumentoOrdenServicio> ?? new List<MultiservicioB.Models.DocumentoOrdenServicio>();
            var puedeSubirDoc = (User.IsInRole("Empleado") && (Model.NombreEstado == "En Progreso" || Model.NombreEstado == "EnProgreso"))
                             || User.IsInRole("Administrador");

            string IconoDoc(string contentType) => contentType switch {
                "application/pdf" => "bi-file-earmark-pdf text-danger",
                "application/msword" => "bi-file-earmark-word text-primary",
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "bi-file-earmark-word text-primary",
                "application/vnd.ms-excel" => "bi-file-earmark-excel text-success",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "bi-file-earmark-excel text-success",
                _ => "bi-file-earmark-text text-secondary"
            };
        }

        <div class="col-12 order-md-3 mt-3">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h4 class="mb-0"><i class="bi bi-folder2-open me-2"></i>Documentos técnicos</h4>
                    <span class="badge bg-secondary">@documentos.Count</span>
                </div>
                <div class="card-body">

                    @if (puedeSubirDoc)
                    {
                        <form asp-controller="Documentos" asp-action="Subir" method="post" enctype="multipart/form-data" class="doc-upload-form mb-3">
                            <input type="hidden" name="ordenId" value="@Model.IdOrden" />
                            <div class="row g-2">
                                <div class="col-sm-5 col-lg-4">
                                    <label class="doc-label">Archivo</label>
                                    <input type="file" name="archivo" class="form-control form-control-sm"
                                           accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" required />
                                </div>
                                <div class="col-sm-3 col-lg-2">
                                    <label class="doc-label">Tipo</label>
                                    <select name="tipoDocumento" class="form-select form-select-sm">
                                        <option value="Informe">Informe</option>
                                        <option value="Manual">Manual</option>
                                        <option value="Plano">Plano</option>
                                        <option value="Procedimiento">Procedimiento</option>
                                        <option value="Otro" selected>Otro</option>
                                    </select>
                                </div>
                                <div class="col-sm col-lg">
                                    <label class="doc-label">Descripción <span class="doc-label-opt">(opcional)</span></label>
                                    <input type="text" name="descripcion" class="form-control form-control-sm" maxlength="200" placeholder="Breve descripción..." />
                                </div>
                                <div class="col-sm-auto d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary btn-sm px-3">
                                        <i class="bi bi-upload me-1"></i>Adjuntar
                                    </button>
                                </div>
                            </div>
                            <div class="doc-hint mt-2">PDF, Word, Excel, TXT &middot; máx 20 MB</div>
                        </form>
                    }

                    @if (documentos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:2rem"></th>
                                        <th>Nombre</th>
                                        <th style="width:9rem">Tipo</th>
                                        <th>Descripción</th>
                                        <th style="width:9rem">Fecha</th>
                                        <th style="width:5.5rem"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in documentos)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <i class="bi @IconoDoc(doc.TipoContenido) fs-5"></i>
                                            </td>
                                            <td class="text-truncate" style="max-width:220px" title="@doc.NombreOriginal">
                                                @doc.NombreOriginal
                                            </td>
                                            <td>
                                                <span class="doc-badge">@doc.TipoDocumento</span>
                                            </td>
                                            <td class="text-muted small text-truncate" style="max-width:180px" title="@doc.Descripcion">
                                                @doc.Descripcion
                                            </td>
                                            <td class="small text-nowrap text-muted">
                                                @doc.FechaCarga.ToString("dd/MM/yy HH:mm")
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Documentos" asp-action="Descargar" asp-route-id="@doc.IdDocumento"
                                                   class="btn btn-sm btn-icon-outline-primary" title="Descargar">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                @if (puedeSubirDoc)
                                                {
                                                    <form asp-controller="Documentos" asp-action="Eliminar" method="post" class="d-inline"
                                                          onsubmit="return confirm('¿Eliminar este documento?')">
                                                        <input type="hidden" name="id" value="@doc.IdDocumento" />
                                                        <input type="hidden" name="ordenId" value="@Model.IdOrden" />
                                                        <button type="submit" class="btn btn-sm btn-icon-outline-danger" title="Eliminar">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0"><i class="bi bi-info-circle me-1"></i>No hay documentos adjuntos aún.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4 order-md-2">
            <div class="card">
                <div class="card-header">
                    <h4>Acciones</h4>
                </div>
                <div class="card-body">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Administrar" asp-route-id="@Model.IdOrden" class="btn btn-outline-primary w-100 mb-2">Administrar orden</a>
                    }
                    @if (User.IsInRole("Administrador") && Model.EmpleadoId.HasValue && Model.NombreEstado == "Pendiente")
                    {
                        <form asp-action="IniciarOrden" asp-route-id="@Model.IdOrden" method="post" class="mb-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-play"></i> Iniciar Orden
                            </button>
                        </form>
                    }
                    @if (User.IsInRole("Administrador") && Model.AvisoTrabajoCompletadoEnviado && (Model.NombreEstado == "En Progreso" || Model.NombreEstado == "EnProgreso"))
                    {
                        <form asp-action="CerrarOrdenDesdeAviso" asp-route-id="@Model.IdOrden" method="post" class="mb-2">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle"></i> Cerrar orden
                            </button>
                        </form>
                    }
                    else if (User.IsInRole("Administrador") && Model.NombreEstado == "En Progreso")
                    {
                        <form asp-action="FinalizarOrden" asp-route-id="@Model.IdOrden" method="post" class="mb-2">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle"></i> Finalizar Orden
                            </button>
                        </form>
                    }
                    @if (User.IsInRole("Empleado") && Model.NombreEstado == "En Progreso")
                    {
                        @if (Model.AvisoTrabajoCompletadoEnviado)
                        {
                            <button type="button" class="btn btn-success w-100 mb-2" disabled>
                                <i class="bi bi-check-circle"></i> Aviso enviado
                            </button>
                        }
                        else
                        {
                            <form asp-action="ReportarTrabajoCompletado" asp-route-id="@Model.IdOrden" method="post" class="mb-2">
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="bi bi-send-check"></i> Avisar trabajo completado
                                </button>
                            </form>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
