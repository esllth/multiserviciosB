@{
    ViewData["Title"] = "Configuración del Sistema";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Configuración del Sistema</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5 d-flex flex-column">
                    <i class="bi bi-clock fs-1 text-primary mb-3 d-block"></i>
                    <h5 class="card-title">Horarios</h5>
                    <p class="card-text text-muted flex-grow-1">Configure los horarios de atención del negocio.</p>
                    <a asp-action="Horarios" class="btn btn-action-view mt-2 align-self-center">
                        <i class="bi bi-arrow-right-circle"></i> Gestionar Horarios
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5 d-flex flex-column">
                    <i class="bi bi-geo-alt fs-1 text-success mb-3 d-block"></i>
                    <h5 class="card-title">Zonas de Cobertura</h5>
                    <p class="card-text text-muted flex-grow-1">Configure las zonas geográficas de cobertura del servicio.</p>
                    <a asp-action="Zonas" class="btn btn-action-view mt-2 align-self-center">
                        <i class="bi bi-arrow-right-circle"></i> Gestionar Zonas
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center py-5 d-flex flex-column">
                    <i class="bi bi-gear fs-1 text-warning mb-3 d-block"></i>
                    <h5 class="card-title">Nosotros en la Revista</h5>
                    <p class="card-text text-muted flex-grow-1">Configure la ubicación, el correo, el teléfono y la presentación del taller.</p>
                    <a asp-action="ConfiguracionGeneral" class="btn btn-action-view mt-2 align-self-center">
                        <i class="bi bi-arrow-right-circle"></i> Configurar Nosotros
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
