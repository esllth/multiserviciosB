@model IEnumerable<MultiservicioB.DTOs.ConfiguracionSistemaDTO>

@{
    ViewData["Title"] = "Parámetros Generales";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Parámetros Generales del Sistema</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            @foreach (var config in Model)
            {
                <form asp-action="ActualizarConfiguracion" method="post" class="mb-4 pb-4 border-bottom">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="@config.Id" name="Id" />
                    <input type="hidden" asp-for="@config.Clave" name="Clave" />

                    <div class="row align-items-end g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Parámetro</label>
                            <p class="form-control-plaintext">
                                <span class="badge bg-secondary">@config.Clave</span>
                            </p>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Valor</label>
                            <input type="text" name="Valor" value="@config.Valor" class="form-control" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Descripción</label>
                            <input type="text" name="Descripcion" value="@config.Descripcion" class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-warning w-100">
                                <i class="bi bi-check-circle"></i> Guardar
                            </button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>
</section>