@model IEnumerable<MultiservicioB.DTOs.HorarioDTO>

@{
    ViewData["Title"] = "Horarios de Atención";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Horarios de Atención</h1>
        <div>
            <a asp-action="Index" class="btn btn-action-cancel me-2">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <a asp-action="CrearHorario" class="btn btn-action-create">
                <i class="bi bi-plus-circle"></i> Nuevo Horario
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th>Hora Inicio</th>
                            <th>Hora Fin</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var horario in Model)
                        {
                            <tr>
                                <td>@horario.DiaSemana</td>
                                <td>@horario.HoraInicio.ToString(@"hh\:mm")</td>
                                <td>@horario.HoraFin.ToString(@"hh\:mm")</td>
                                <td>
                                    @if (horario.Activo)
                                    {
                                        <span class="idx-badge @EstadoBadge.ConfiguracionDisponible("Activo")">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="idx-badge @EstadoBadge.ConfiguracionDisponible("Inactivo")">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="EditarHorario" asp-route-id="@horario.Id"
                                       class="btn btn-sm btn-action-edit">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a asp-action="ConfirmarEliminarHorario" asp-route-id="@horario.Id"
                                       class="btn btn-sm btn-action-delete">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
