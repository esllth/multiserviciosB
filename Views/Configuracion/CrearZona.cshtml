@model MultiservicioB.DTOs.ZonaDTO

@{
    ViewData["Title"] = "Crear Zona";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Nueva Zona de Cobertura</h1>
        <a asp-action="Zonas" class="btn btn-action-cancel">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="CrearZona" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Provincia" type="hidden" id="zonaNombreProvincia" />
                <input asp-for="Canton" type="hidden" id="zonaNombreCanton" />
                <input asp-for="Distrito" type="hidden" id="zonaNombreDistrito" />
                <input asp-for="CodigoDTA" type="hidden" id="zonaCodigoDTA" />

                <div class="mb-3">
                    <label asp-for="Provincia" class="form-label fw-bold"></label>
                    <select id="zonaProvincia" class="form-select"><option value="">Cargando provincias...</option></select>
                    <span asp-validation-for="Provincia" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Canton" class="form-label fw-bold"></label>
                    <select id="zonaCanton" class="form-select" disabled><option value="">Seleccione un cantón</option></select>
                    <span asp-validation-for="Canton" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Distrito" class="form-label fw-bold"></label>
                    <select id="zonaDistrito" class="form-select" disabled><option value="">Seleccione un distrito</option></select>
                    <span asp-validation-for="Distrito" class="text-danger"></span>
                    <span asp-validation-for="CodigoDTA" class="text-danger d-block"></span>
                    <div id="zonaCodigoVisible" class="form-text"></div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"
                              placeholder="Descripción adicional de la zona..."></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" />
                        <label asp-for="Activo" class="form-check-label fw-bold"></label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-action-save">
                        <i class="bi bi-check-circle"></i> Guardar
                    </button>
                    <a asp-action="Zonas" class="btn btn-action-cancel">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_ZonaDtaScripts" />
}
