@model MultiservicioB.ViewModels.RevistaViewModel
@{
    ViewData["Title"] = "Revista";
    ViewData["FullBleed"] = true;

    string UrlImagen(string imagen) =>
        imagen.StartsWith("archivo:")
            ? Url.Action("Imagen", "Revista", new { nombre = imagen["archivo:".Length..] })!
            : Url.Content($"~{imagen}");
}

<section class="hero">
    <div class="home-hero">
        <img src="@UrlImagen(Model.ImagenPrincipal)"
             class="home-hero-image"
             alt="Trabajo técnico de Multiservicio Bolívar" />

        <div class="home-hero-copy">
            <h1 class="hero-title">@Model.Titulo</h1>
            <p class="hero-sub">@Model.Descripcion</p>
        </div>
    </div>
</section>

<section class="showcase" aria-label="Trabajos destacados">
    <div class="showcase-heading">
        <p class="showcase-kicker">@Model.Encabezado</p>
        <h2>@Model.Subtitulo</h2>
    </div>

    <div class="showcase-grid">
        @for (var i = 0; i < Model.Tarjetas.Count; i++)
        {
            var tarjeta = Model.Tarjetas[i];
            <article class="showcase-card @(i == 0 ? "showcase-card-featured" : "")">
                <img src="@UrlImagen(tarjeta.Imagen)" alt="@tarjeta.Titulo" class="showcase-img" loading="lazy" />
                <div class="showcase-card-body">
                    <h3>@tarjeta.Titulo</h3>
                    <p>@tarjeta.Descripcion</p>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Cliente"))
                    {
                        <a asp-controller="Cotizaciones" asp-action="Solicitar" class="showcase-link">@tarjeta.TextoEnlace</a>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">@tarjeta.TextoEnlace</a>
                    }
                </div>
            </article>
        }
    </div>
</section>
