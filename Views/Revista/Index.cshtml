@model MultiservicioB.ViewModels.RevistaViewModel
@{
    ViewData["Title"] = "Revista";
    ViewData["FullBleed"] = true;

    string UrlImagen(string imagen) =>
        imagen.StartsWith("archivo:")
            ? Url.Action("Imagen", "Revista", new { nombre = imagen["archivo:".Length..] })!
            : Url.Content($"~{imagen}");

    string FormatoHora(TimeSpan hora) =>
        DateTime.Today.Add(hora).ToString("hh:mm tt");

    var urlChatFabricacion = Url.Action("ChatCotizacion", "FabricacionAmedida");
}

<section class="hero">
    <div class="home-hero">
        <img src="@UrlImagen(Model.ImagenPrincipal)"
             class="home-hero-image"
             alt="Trabajo técnico de Multiservicio Bolívar" />

        <div class="home-hero-copy">
            <h1 class="hero-title">@Model.Titulo</h1>
            <p class="hero-sub">@Model.Descripcion</p>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Cliente"))
            {
                <a asp-controller="FabricacionAmedida" asp-action="ChatCotizacion" class="revista-chat-link">
                    Cotizar con asistente
                </a>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@urlChatFabricacion" class="revista-chat-link">
                    Cotizar con asistente
                </a>
            }
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Nosotros.UbicacionTaller) ||
     !string.IsNullOrWhiteSpace(Model.Nosotros.CorreoElectronico) ||
     !string.IsNullOrWhiteSpace(Model.Nosotros.NumeroTelefono) ||
     !string.IsNullOrWhiteSpace(Model.Nosotros.Leyenda))
{
    <section class="revista-about" aria-labelledby="revista-about-title">
        <div class="revista-about-inner">
            <div class="revista-about-intro">
                <p class="revista-about-kicker">Conózcanos</p>
                <h2 id="revista-about-title">Nosotros</h2>
                @if (!string.IsNullOrWhiteSpace(Model.Nosotros.Leyenda))
                {
                    <p class="revista-about-legend">@Model.Nosotros.Leyenda</p>
                }
            </div>

            <div class="revista-about-contact">
                @if (!string.IsNullOrWhiteSpace(Model.Nosotros.UbicacionTaller))
                {
                    <div class="revista-about-item">
                        <i class="bi bi-geo-alt" aria-hidden="true"></i>
                        <div><strong>Visite nuestro taller</strong><span>@Model.Nosotros.UbicacionTaller</span></div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Nosotros.CorreoElectronico))
                {
                    <div class="revista-about-item">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <div><strong>Correo electrónico</strong><span>@Model.Nosotros.CorreoElectronico</span></div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Nosotros.NumeroTelefono))
                {
                    <div class="revista-about-item">
                        <i class="bi bi-telephone" aria-hidden="true"></i>
                        <div><strong>Llámenos</strong><span>@Model.Nosotros.NumeroTelefono</span></div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.HorariosDisponibles.Any())
{
    <section class="availability" aria-label="Horarios disponibles">
        <div class="availability-inner">
            <div class="availability-heading">
                <h2>Horario de atención</h2>
            </div>

            <div class="availability-grid">
                @foreach (var horario in Model.HorariosDisponibles)
                {
                    <article class="availability-item">
                        <strong>@horario.DiaSemana</strong>
                        <span>@FormatoHora(horario.HoraInicio) - @FormatoHora(horario.HoraFin)</span>
                    </article>
                }
            </div>
        </div>
    </section>
}

@if (Model.ZonasCobertura.Any())
{
    <section class="coverage" aria-labelledby="coverage-title">
        <div class="coverage-inner">
            <div class="coverage-heading">
                <p>Zonas de cobertura</p>
                <h2 id="coverage-title">Llegamos hasta donde nos necesita</h2>
            </div>
            <div class="coverage-grid">
                @foreach (var zona in Model.ZonasCobertura)
                {
                    <article class="coverage-item">
                        <i class="bi bi-geo-alt-fill"></i>
                        <div>
                            <strong>@zona.Distrito, @zona.Canton</strong>
                            <span>@zona.Provincia</span>
                            @if (!string.IsNullOrWhiteSpace(zona.Descripcion)) { <small>@zona.Descripcion</small> }
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

<style>
    .coverage { padding: 4rem 1rem; background: #eef7f1; }
    .coverage-inner { max-width: 1180px; margin: 0 auto; }
    .coverage-heading { margin-bottom: 1.5rem; }
    .coverage-heading p { color: #15803d; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; margin-bottom: .35rem; }
    .coverage-heading h2 { margin: 0; }
    .coverage-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(235px, 1fr)); gap: 1rem; }
    .coverage-item { display: flex; gap: .9rem; padding: 1.1rem; background: #fff; border: 1px solid #bbf7d0; border-radius: 12px; }
    .coverage-item i { color: #16a34a; font-size: 1.35rem; }
    .coverage-item div { display: flex; flex-direction: column; }
    .coverage-item strong,
    .coverage-item span,
    .coverage-item small {
        font-size: 1rem;
        line-height: 1.45;
    }
    .coverage-item span, .coverage-item small { color: #64748b; }
    .availability {
        padding: 4rem 1rem;
        background: #f8fafc;
    }

    .availability-inner {
        max-width: 1180px;
        margin: 0 auto;
    }

    .availability-heading {
        margin-bottom: 1.5rem;
    }

    .availability-heading h2,
    .coverage-heading h2 {
        margin: 0;
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        font-weight: 500;
        line-height: 1.15;
    }

    .availability-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: .85rem;
    }

    .availability-item {
        min-height: 86px;
        border: 1px solid #bbf7d0;
        background: #ffffff;
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: .35rem;
    }

    .availability-item strong {
        color: #14532d;
        font-size: 1rem;
        line-height: 1.45;
    }

    .availability-item span {
        color: #166534;
        font-weight: 600;
        font-size: 1rem;
        line-height: 1.45;
    }

    .revista-about {
        position: relative;
        z-index: 3;
        margin: 2rem clamp(1rem, 3vw, 3rem);
        padding: 4.5rem 1rem;
        border: 4px solid #17663c;
        border-radius: 2rem;
        background: rgba(255, 255, 255, .04);
        -webkit-backdrop-filter: blur(14px) saturate(115%);
        backdrop-filter: blur(14px) saturate(115%);
        color: #ffffff;
        box-shadow:
            18px 18px 38px rgba(23, 102, 60, .18),
            -12px -12px 30px rgba(255, 255, 255, .8),
            inset 0 0 0 1px rgba(255, 255, 255, .5);
        overflow: hidden;
    }

    .revista-about::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 4rem;
        background: linear-gradient(180deg, rgba(23, 102, 60, .06), transparent);
        pointer-events: none;
    }

    .revista-about-inner {
        position: relative;
        z-index: 1;
        max-width: 1180px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, .9fr);
        gap: 3rem;
        align-items: center;
    }

    .revista-about-kicker {
        margin: 0 0 .6rem;
        color: #bbf7d0;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .revista-about-intro h2 {
        margin: 0 0 1rem;
        color: #ffffff;
        font-size: clamp(2rem, 4vw, 3.2rem);
    }

    .revista-about-intro {
        padding: clamp(1.5rem, 3vw, 2.25rem);
        border: 1px solid rgba(255, 255, 255, .22);
        border-radius: 1.25rem;
        background: linear-gradient(135deg, rgba(12, 67, 40, .96), rgba(23, 102, 60, .9));
        box-shadow: 0 16px 32px rgba(12, 67, 40, .18);
    }

    .revista-about-legend {
        max-width: 650px;
        margin: 0;
        color: #f0fdf4;
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        line-height: 1.7;
    }

    .revista-about-contact {
        display: grid;
        gap: .85rem;
    }

    .revista-about-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border: 2px solid rgba(23, 102, 60, .72);
        border-radius: 1rem;
        background: linear-gradient(135deg, rgba(12, 67, 40, .94), rgba(23, 102, 60, .86));
        backdrop-filter: blur(8px);
        color: #ffffff;
        text-decoration: none;
    }

    .revista-about-item i {
        color: #bbf7d0;
        font-size: 1.4rem;
    }

    .revista-about-item div {
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .revista-about-item span {
        color: #f0fdf4;
    }

    a.revista-about-item:hover {
        border-color: #22c55e;
        background: linear-gradient(135deg, rgba(16, 89, 52, .98), rgba(25, 119, 67, .92));
        color: #ffffff;
    }

    @@media (max-width: 767px) {
        .revista-about {
            margin: 1rem .75rem;
            padding: 3.5rem 1rem;
            border-radius: 1.35rem;
        }

        .revista-about-inner {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }

    .revista-chat-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        margin-top: 1rem;
        padding: .7rem 1rem;
        border-radius: 8px;
        background: #16a34a;
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
    }

    .revista-chat-link:hover {
        background: #15803d;
        color: #ffffff;
    }
</style>

<section class="showcase" aria-label="Trabajos destacados">
    <div class="showcase-heading">
        <p class="showcase-kicker">@Model.Encabezado</p>
        <h2>@Model.Subtitulo</h2>
    </div>

    <div class="showcase-grid">
        @for (var i = 0; i < Model.Tarjetas.Count; i++)
        {
            var tarjeta = Model.Tarjetas[i];
            var esFabricacion = tarjeta.Titulo.Contains("Fabric", StringComparison.OrdinalIgnoreCase);
            <article class="showcase-card @(i == 0 ? "showcase-card-featured" : "")">
                <img src="@UrlImagen(tarjeta.Imagen)" alt="@tarjeta.Titulo" class="showcase-img" loading="lazy" />
                <div class="showcase-card-body">
                    <h3>@tarjeta.Titulo</h3>
                    <p>@tarjeta.Descripcion</p>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Cliente"))
                    {
                        @if (esFabricacion)
                        {
                            <a asp-controller="FabricacionAmedida" asp-action="ChatCotizacion" class="showcase-link">Cotizar con asistente</a>
                        }
                        else
                        {
                            <a asp-controller="Cotizaciones" asp-action="Solicitar" class="showcase-link">@tarjeta.TextoEnlace</a>
                        }
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        @if (esFabricacion)
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@urlChatFabricacion" class="showcase-link">Cotizar con asistente</a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">@tarjeta.TextoEnlace</a>
                        }
                    }
                </div>
            </article>
        }
    </div>
</section>
