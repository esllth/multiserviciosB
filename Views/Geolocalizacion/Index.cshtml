@{
    ViewData["Title"] = "Geolocalización";
}

<style>
    .geo-page { padding: 1.5rem 0; }

    .geo-search-bar .input-group {
        border: 1.5px solid #d1d5db;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }

    .geo-search-bar .form-control:focus { box-shadow: none; }

    .geo-layout {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 1rem;
        height: 520px;
    }

    @@media (max-width: 768px) {
        .geo-layout { grid-template-columns: 1fr; height: auto; }
    }

    .geo-panel {
        overflow-y: auto;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        padding: .5rem;
    }

    .geo-map-wrap { position: relative; border-radius: 12px; overflow: hidden; }
    #mapa { width: 100%; height: 100%; min-height: 400px; }

    .geo-map-hint {
        position: absolute;
        bottom: .75rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255,255,255,.9);
        padding: .3rem .8rem;
        border-radius: 999px;
        font-size: .75rem;
        color: #6b7280;
        pointer-events: none;
        white-space: nowrap;
    }

    .geo-empty { text-align: center; padding: 2.5rem 1rem; color: #9ca3af; }
    .geo-empty-icon { font-size: 2.5rem; display: block; margin-bottom: .5rem; }
    .geo-empty-title { font-weight: 600; font-size: .95rem; color: #6b7280; margin: 0; }
    .geo-empty-sub { font-size: .8rem; margin: .25rem 0 0; }

    .geo-card {
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: .75rem;
        margin-bottom: .5rem;
        cursor: pointer;
        transition: border-color .15s, box-shadow .15s;
    }

    .geo-card:hover, .geo-card.activa {
        border-color: #0073f3;
        box-shadow: 0 0 0 3px rgba(0,115,243,.1);
    }

    .geo-card-header { display: flex; align-items: flex-start; gap: .6rem; }

    .geo-avatar {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: .85rem; flex-shrink: 0;
    }

    .geo-avatar-cliente  { background: rgba(0,115,243,.12); color: #0053af; }
    .geo-avatar-empleado { background: var(--state-neutral-bg); color: var(--state-neutral-text); }

    .geo-card-nombre    { font-weight: 600; font-size: .9rem; color: #111827; line-height: 1.2; }
    .geo-card-subtitulo { font-size: .75rem; color: #6b7280; }

    .geo-card-info { margin-top: .5rem; font-size: .78rem; color: #4b5563; display: grid; gap: .2rem; }
    .geo-card-info span { display: flex; align-items: center; gap: .4rem; }

    .geo-spinner { text-align: center; padding: 1.5rem; color: #6b7280; font-size: .85rem; }

    .geo-no-coords {
        font-size: .7rem; color: var(--state-neutral-text); margin-top: .3rem;
        display: flex; align-items: center; gap: .3rem;
    }
</style>

<div class="geo-page">

    <div class="idx-header mb-3">
        <div>
            <h1 class="idx-title"><i class="bi bi-geo-alt me-2"></i>Geolocalización</h1>
            <p class="idx-sub">Busque clientes, negocios o empleados y visualice su ubicación en el mapa.</p>
        </div>
    </div>

    <div class="geo-search-bar mb-3">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-search text-secondary"></i>
            </span>
            <input type="text" id="inputBusqueda" class="form-control border-start-0 ps-0"
                   placeholder="Nombre, negocio, cédula..." autocomplete="off" />
            <button class="btn btn-action-filter" type="button" id="btnLimpiar" style="display:none">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div id="busquedaEstado" class="form-text ms-1 mt-1"></div>
    </div>

    <div class="geo-layout">
        <div class="geo-panel" id="panelResultados">
            <div class="geo-empty" id="geoEmpty">
                <i class="bi bi-map-fill geo-empty-icon"></i>
                <p class="geo-empty-title">Ingrese un término de búsqueda</p>
                <p class="geo-empty-sub">Puede buscar por nombre, apellido, negocio o cédula.</p>
            </div>
            <div id="listaResultados"></div>
        </div>

        <div class="geo-map-wrap">
            <div id="mapa"></div>
            <div class="geo-map-hint" id="mapaHint">
                <i class="bi bi-info-circle me-1"></i>Los marcadores aparecerán al buscar.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    (function () {
        const input    = document.getElementById('inputBusqueda');
        const btnLimp  = document.getElementById('btnLimpiar');
        const estado   = document.getElementById('busquedaEstado');
        const lista    = document.getElementById('listaResultados');
        const empty    = document.getElementById('geoEmpty');
        const mapaHint = document.getElementById('mapaHint');

        const mapa = L.map('mapa').setView([9.748917, -83.753428], 8);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a>',
            maxZoom: 18
        }).addTo(mapa);

        const markers = {};
        const markerGroup = L.layerGroup().addTo(mapa);
        let cardActiva = null;

        function iconoColor(tipo) {
            return L.icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${tipo === 'Cliente' ? 'blue' : 'gold'}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
            });
        }

        function estadoBadge(estado) {
            const map = {
                'Completada': '@EstadoBadge.OrdenServicio("Completada")',
                'En Progreso': '@EstadoBadge.OrdenServicio("En Progreso")',
                'EnProgreso': '@EstadoBadge.OrdenServicio("EnProgreso")',
                'Pendiente': '@EstadoBadge.OrdenServicio("Pendiente")',
                'Cancelada': '@EstadoBadge.OrdenServicio("Cancelada")'
            };
            const clase = map[estado] || '@EstadoBadge.General(null)';
            return `<span class="idx-badge ${clase}">${estado}</span>`;
        }

        function construirPopup(r) {
            let html = `<div style="min-width:200px;max-width:260px">`;
            html += `<b style="font-size:.95rem">${r.nombre}</b>`;
            if (r.subtitulo) html += `<br><span style="font-size:.78rem;color:#6b7280">🏪 ${r.subtitulo}</span>`;
            html += `<br><span style="font-size:.75rem;color:#4b5563">📍 ${r.distrito}, ${r.canton}, ${r.provincia}</span>`;
            if (r.otrasSenas) html += `<br><span style="font-size:.72rem;color:#6b7280">${r.otrasSenas}</span>`;

            if (r.ordenes && r.ordenes.length > 0) {
                html += `<hr style="margin:.5rem 0;border-color:#e5e7eb">`;
                html += `<div style="font-size:.72rem;font-weight:600;color:#374151;margin-bottom:.3rem">Últimas órdenes</div>`;
                for (const o of r.ordenes) {
                    const fecha = new Date(o.fecha).toLocaleDateString('es-CR', { day: '2-digit', month: 'short', year: 'numeric' });
                    html += `<div style="margin-bottom:.3rem;padding:.25rem .4rem;background:#f9fafb;border-radius:6px;border:1px solid #e5e7eb">`;
                    html += `<div style="display:flex;justify-content:space-between;align-items:center">`;
                    html += `<span style="font-size:.7rem;color:#6b7280">#${o.id} &middot; ${fecha}</span>`;
                    html += estadoBadge(o.estado);
                    html += `</div>`;
                    if (o.tecnico) html += `<div style="font-size:.68rem;color:#6b7280;margin-top:.1rem">👷 ${o.tecnico}</div>`;
                    html += `</div>`;
                }
            } else {
                html += `<div style="margin-top:.4rem;font-size:.72rem;color:#9ca3af">Sin órdenes registradas.</div>`;
            }
            html += `</div>`;
            return html;
        }

        async function geocodificar(provincia, canton, distrito, otrasSenas) {
            const intentos = [];
            if (otrasSenas) intentos.push(`${otrasSenas}, ${distrito}, ${canton}, ${provincia}, Costa Rica`);
            intentos.push(`${distrito}, ${canton}, ${provincia}, Costa Rica`);

            for (const q of intentos) {
                try {
                    const res = await fetch(
                        `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=1&countrycodes=cr`,
                        { headers: { 'Accept-Language': 'es' } }
                    );
                    const data = await res.json();
                    if (data.length > 0) return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
                } catch {}
            }
            return null;
        }

        function crearCard(r, index) {
            const div = document.createElement('div');
            div.className = 'geo-card';
            div.dataset.index = index;

            const inicial   = r.nombre ? r.nombre[0].toUpperCase() : '?';
            const avatarCls = r.tipo === 'Cliente' ? 'geo-avatar-cliente' : 'geo-avatar-empleado';
            const badgeCls = '@EstadoBadge.General("Cliente")';

            let infoHtml = '';
            if (r.provincia)  infoHtml += `<span><i class="bi bi-geo-alt text-secondary"></i>${r.distrito}, ${r.canton}, ${r.provincia}</span>`;
            if (r.otrasSenas) infoHtml += `<span><i class="bi bi-pin-map text-secondary"></i>${r.otrasSenas}</span>`;
            if (r.telefono)   infoHtml += `<span><i class="bi bi-telephone text-secondary"></i>${r.telefono}</span>`;
            if (r.correo)     infoHtml += `<span><i class="bi bi-envelope text-secondary"></i>${r.correo}</span>`;

            div.innerHTML = `
                <div class="geo-card-header">
                    <span class="geo-avatar ${avatarCls}">${inicial}</span>
                    <div style="flex:1;min-width:0">
                        <div class="geo-card-nombre">${r.nombre}</div>
                        ${r.subtitulo ? `<div class="geo-card-subtitulo"><i class="bi bi-shop me-1"></i>${r.subtitulo}</div>` : ''}
                    </div>
                    <span class="idx-badge ${badgeCls}">${r.tipo}</span>
                </div>
                ${infoHtml ? `<div class="geo-card-info">${infoHtml}</div>` : ''}
                <div class="geo-no-coords d-none" id="noCoords${index}">
                    <i class="bi bi-exclamation-triangle"></i>Sin coordenadas disponibles.
                </div>`;

            div.addEventListener('click', () => activarCard(div, index));
            return div;
        }

        function activarCard(card, index) {
            if (cardActiva) cardActiva.classList.remove('activa');
            card.classList.add('activa');
            cardActiva = card;
            if (markers[index]) {
                mapa.setView(markers[index].getLatLng(), 14);
                markers[index].openPopup();
            }
        }

        async function buscar(q) {
            lista.innerHTML = '<div class="geo-spinner"><div class="spinner-border spinner-border-sm me-2"></div>Buscando...</div>';
            empty.style.display = 'none';
            markerGroup.clearLayers();
            Object.keys(markers).forEach(k => delete markers[k]);
            cardActiva = null;

            const res   = await fetch(`/Geolocalizacion/Buscar?q=${encodeURIComponent(q)}`);
            const datos = await res.json();
            lista.innerHTML = '';

            if (!datos.length) {
                empty.style.display = '';
                empty.querySelector('.geo-empty-title').textContent = 'Sin resultados';
                empty.querySelector('.geo-empty-sub').textContent = `No se encontraron coincidencias para "${q}".`;
                estado.textContent = '0 resultados';
                return;
            }

            estado.textContent = `${datos.length} resultado(s)`;
            mapaHint.style.display = 'none';

            const bounds = [];
            for (let i = 0; i < datos.length; i++) {
                const r    = datos[i];
                const card = crearCard(r, i);
                lista.appendChild(card);

                if (r.provincia && r.canton && r.distrito) {
                    const coords = await geocodificar(r.provincia, r.canton, r.distrito, r.otrasSenas);
                    if (coords) {
                        const marker = L.marker([coords.lat, coords.lng], { icon: iconoColor(r.tipo) })
                            .addTo(markerGroup)
                            .bindPopup(construirPopup(r), { maxWidth: 280 });
                        marker.on('click', () => activarCard(card, i));
                        markers[i] = marker;
                        bounds.push([coords.lat, coords.lng]);
                    } else {
                        document.getElementById(`noCoords${i}`)?.classList.remove('d-none');
                    }
                }
            }

            if (bounds.length > 0) mapa.fitBounds(bounds, { padding: [40, 40] });
        }

        let timer;
        input.addEventListener('input', () => {
            const q = input.value.trim();
            btnLimp.style.display = q ? '' : 'none';
            clearTimeout(timer);
            if (q.length < 2) {
                lista.innerHTML = '';
                empty.style.display = '';
                empty.querySelector('.geo-empty-title').textContent = 'Ingrese un término de búsqueda';
                empty.querySelector('.geo-empty-sub').textContent = 'Puede buscar por nombre, apellido, negocio o cédula.';
                estado.textContent = '';
                markerGroup.clearLayers();
                mapaHint.style.display = '';
                return;
            }
            estado.textContent = 'Buscando...';
            timer = setTimeout(() => buscar(q), 500);
        });

        btnLimp.addEventListener('click', () => {
            input.value = '';
            input.dispatchEvent(new Event('input'));
            input.focus();
        });
    })();
    </script>
}
