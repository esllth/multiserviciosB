@model MultiservicioB.ViewModels.EncuestasIndexViewModel
@{
    ViewData["Title"] = "Resultados de encuestas";
}

<section class="container py-5">
    <div class="mb-4">
        <span class="dashboard-eyebrow">Calidad del servicio</span>
        <h1 class="site-heading">Resultados de encuestas</h1>
        <p class="text-muted">Calificaciones enviadas por los clientes después de completar una orden.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted">Respuestas</small><div class="display-6 fw-bold">@Model.TotalRespuestas</div></div></div></div>
        <div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted">Promedio del servicio</small><div class="display-6 fw-bold text-warning">@Model.PromedioServicio.ToString("0.0") <i class="bi bi-star-fill fs-4"></i></div></div></div></div>
        <div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted">Promedio del técnico</small><div class="display-6 fw-bold text-warning">@Model.PromedioTecnico.ToString("0.0") <i class="bi bi-star-fill fs-4"></i></div></div></div></div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Orden</th><th>Cliente</th><th>Técnico</th><th>Servicio</th><th>Técnico</th><th>Comentario</th><th>Fecha</th></tr></thead>
                <tbody>
                @if (Model.Resultados.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">Todavía no hay encuestas respondidas.</td></tr>
                }
                else
                {
                    @foreach (var resultado in Model.Resultados)
                    {
                        <tr>
                            <td><a asp-controller="Tecnicos" asp-action="Detalle" asp-route-id="@resultado.OrdenId">#@resultado.OrdenId</a></td>
                            <td>@resultado.Cliente</td>
                            <td>@resultado.Tecnico</td>
                            <td class="text-warning text-nowrap" aria-label="@resultado.CalificacionServicio de 5 estrellas">@Html.Raw(string.Concat(Enumerable.Repeat("<i class=\"bi bi-star-fill\"></i>", resultado.CalificacionServicio)))</td>
                            <td class="text-warning text-nowrap" aria-label="@resultado.CalificacionTecnico de 5 estrellas">@Html.Raw(string.Concat(Enumerable.Repeat("<i class=\"bi bi-star-fill\"></i>", resultado.CalificacionTecnico)))</td>
                            <td>@(string.IsNullOrWhiteSpace(resultado.Comentarios) ? "—" : resultado.Comentarios)</td>
                            <td class="text-nowrap">@(resultado.Fecha?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
