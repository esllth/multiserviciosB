@model MultiservicioB.ViewModels.ResponderEncuestaViewModel
@{
    ViewData["Title"] = "Encuesta de satisfacción";
}

<section class="container py-5" style="max-width:760px">
    <div class="card shadow-sm">
        <div class="card-body p-4 p-md-5">
            <h1 class="site-heading">Cuéntenos cómo fue el servicio</h1>
            <p class="text-muted">Su opinión sobre la orden #@Model.OrdenId nos ayuda a mejorar.</p>

            <form asp-action="Responder" method="post">
                <input asp-for="OrdenId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="CalificacionServicio" class="form-label fw-semibold d-block"></label>
                    <div class="star-rating" aria-label="Calificación del servicio">
                        @for (var estrella = 5; estrella >= 1; estrella--)
                        {
                            <input asp-for="CalificacionServicio" type="radio" id="servicio-@estrella" value="@estrella" />
                            <label for="servicio-@estrella" title="@estrella estrellas"><i class="bi bi-star-fill"></i></label>
                        }
                    </div>
                    <span asp-validation-for="CalificacionServicio" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CalificacionTecnico" class="form-label fw-semibold d-block"></label>
                    <div class="star-rating" aria-label="Calificación del técnico">
                        @for (var estrella = 5; estrella >= 1; estrella--)
                        {
                            <input asp-for="CalificacionTecnico" type="radio" id="tecnico-@estrella" value="@estrella" />
                            <label for="tecnico-@estrella" title="@estrella estrellas"><i class="bi bi-star-fill"></i></label>
                        }
                    </div>
                    <span asp-validation-for="CalificacionTecnico" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-action-save">Enviar encuesta</button>
            </form>
        </div>
    </div>
</section>

<style>
    .star-rating { display:inline-flex; flex-direction:row-reverse; gap:.35rem; }
    .star-rating input { position:absolute; opacity:0; pointer-events:none; }
    .star-rating label { color:#d1d5db; cursor:pointer; font-size:2.25rem; line-height:1; transition:color .15s, transform .15s; }
    .star-rating label:hover, .star-rating label:hover ~ label,
    .star-rating input:checked ~ label { color:#f59e0b; }
    .star-rating label:hover { transform:scale(1.1); }
    .star-rating input:focus-visible + label { outline:2px solid #2563eb; outline-offset:3px; }
</style>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
