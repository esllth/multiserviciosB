@{
    ViewData["Title"] = "Inicio Cliente";
}

<div class="container mt-3">

    <!-- ENCABEZADO -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary site-heading">Panel de Cliente</h1>
        <p class="lead text-muted">Bienvenido, @User.Identity?.Name</p>
        <p>Cotiza, consulta ordenes de servicio y califica nuestro servicio con la opción de encuestas...</p>
    </div>

    <!-- MÓDULOS DE NAVEGACIÓN -->
    
    <div class="row justify-content-center text-center g-4 mt-3">

        <!-- Portal cliente -->
        <div class="col-md-4">
            <a asp-controller="PortalCliente" asp-action="Index" class="text-decoration-none">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Visitas.png"))" alt="PortalCliente" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Mi portal</h5>
                        <p class="card-text text-muted">Consultar el estado de mis cotizaciones, ordenes de servicio y más</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Encuestas -->
        <div class="col-md-4">
            <a asp-controller="Encuestas" asp-action="Index" class="text-decoration-none">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Lapiz.png"))" alt="EncuestasYCalidad" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Encuestas</h5>
                        <p class="card-text text-muted">Encuestas de la calidad del servicio</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

</div>

<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .hover-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>

