@model MultiservicioB.ViewModels.ClienteFormViewModel
@{
    ViewData["Title"] = "Crear cliente";
}

<div class="emp-create-page">

    <div class="emp-page-header">
        <a asp-action="Index" class="emp-back-link">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
        <h1 class="emp-page-title">Nuevo cliente</h1>
        <p class="emp-page-sub">Complete los datos del cliente. El nombre se autocompleta con la identificación.</p>
    </div>

    <partial name="_Formulario" model="Model" />

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <partial name="_DtaScripts" />
}
