@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav nav-auth-actions">
    @if (SignInManager.IsSignedIn(User))
    {
        var email = User.Identity?.Name ?? "";
        var initials = email.Length > 0 ? email[0].ToString().ToUpper() : "U";
        <li class="nav-item dropdown">
            <a class="nav-user-chip dropdown-toggle" href="#" id="navbarUser" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <span class="nav-user-avatar">@initials</span>
                <span class="nav-user-email">@email</span>
                <i class="bi bi-chevron-down nav-user-chevron"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end nav-user-menu" aria-labelledby="navbarUser">
                <li class="nav-user-menu-header">
                    <span class="nav-user-menu-email">@email</span>
                </li>
                <li><hr class="dropdown-divider"></li>
                @if (User.IsInRole("Cliente"))
                {
                    <li>
                        <a asp-controller="Cliente" asp-action="Perfil" class="dropdown-item">
                            <i class="bi bi-person me-2"></i>Mi perfil
                        </a>
                    </li>
                }
                @if (User.IsInRole("Empleado"))
                {
                    <li>
                        <a asp-controller="Empleados" asp-action="MiPerfil" class="dropdown-item">
                            <i class="bi bi-person-badge me-2"></i>Mi perfil
                        </a>
                    </li>
                }
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline w-100">
                        <button type="submit" class="dropdown-item nav-user-logout">
                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link nav-auth-link" asp-area="Identity" asp-page="/Account/Login">
                Iniciar sesión
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link nav-auth-link nav-auth-primary btn-auth-primary" asp-area="Identity" asp-page="/Account/Register">
                Registrarse
            </a>
        </li>
    }
</ul>
