@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
    </li>

    @if (User.IsInRole("Administrador"))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarUsuarios" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Usuarios
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarUsuarios">
                <li><a class="dropdown-item" asp-controller="Empleados" asp-action="Index">Personal</a></li>
                <li><a class="dropdown-item" asp-controller="Cliente" asp-action="Index">Clientes</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Gestionar roles</a></li>
            </ul>
        </li>
    }

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarOperaciones" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Operaciones
        </a>
        <ul class="dropdown-menu" aria-labelledby="navbarOperaciones">
            @if (User.IsInRole("Administrador"))
            {
                <li><a class="dropdown-item" asp-controller="Servicios" asp-action="Index">Servicios</a></li>
                <li><a class="dropdown-item" asp-controller="Equipos" asp-action="Index">Equipos</a></li>
                <li><a class="dropdown-item" asp-controller="Tecnicos" asp-action="Index">Órdenes de servicio</a></li>
                <li><a class="dropdown-item" asp-controller="Cotizaciones" asp-action="Index">Cotizaciones</a></li>
            }

            @if (User.IsInRole("Empleado"))
            {
                <li><a class="dropdown-item" asp-controller="Tecnicos" asp-action="Index">Mis órdenes</a></li>
                <li><a class="dropdown-item" asp-controller="Equipos" asp-action="Index">Equipos</a></li>
            }

            @if (User.IsInRole("Cliente"))
            {
                <li><a class="dropdown-item" asp-controller="PortalCliente" asp-action="Index">Portal</a></li>
                <li><a class="dropdown-item" asp-controller="Cotizaciones" asp-action="Index">Cotizaciones</a></li>
                <li><a class="dropdown-item" asp-controller="Tecnicos" asp-action="Index">Órdenes de servicio</a></li>
                <li><a class="dropdown-item" asp-controller="FabricacionAmedida" asp-action="Index">Fabricación a medida</a></li>
                <li><a class="dropdown-item" asp-controller="Encuestas" asp-action="Index">Encuestas</a></li>
            }
        </ul>
    </li>

    @if (User.IsInRole("Administrador") || User.IsInRole("Empleado"))
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Materiales" asp-action="Index">Materiales</a>
        </li>
    }

    @if (User.IsInRole("Administrador"))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarSistema" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Sistema
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarSistema">
                <li><a class="dropdown-item" asp-controller="Configuracion" asp-action="Index">Configuración</a></li>
            </ul>
        </li>
    }
}
