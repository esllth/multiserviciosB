<!DOCTYPE html>
<html lang="es">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Multiservicio Bolívar
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body class="layout-body @(string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Identity", StringComparison.OrdinalIgnoreCase) ? "identity-body" : "")">

    <header>

        <nav class="navbar navbar-expand-lg navbar-light saas-navbar">
            <div class="site-container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="@(Url.Content("~/images/Logo/logo.png"))" class="brand-logo" alt="Logo Multiservicio Bolívar" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav navbar-left-links">
                        <partial name="_RoleNavigationPartial" />
                    </ul>
                    <div class="ms-auto nav-header-actions">
                        @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Revista", StringComparison.OrdinalIgnoreCase))
                        {
                            <button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar a modo oscuro" title="Cambiar tema">
                                <i class="bi bi-moon-stars-fill" aria-hidden="true"></i><span class="visually-hidden">Cambiar tema</span>
                            </button>
                        }
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>

    </header>

    <main class="main-content @(ViewData["FullBleed"] as bool? == true ? "main-content-full" : "")">

        @if (ViewData["FullBleed"] as bool? == true)
        {
            @RenderBody()
        }
        else
        {
            <div class="site-container">

                @RenderBody()

            </div>
        }

    </main>

    <partial name="_Footer" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
