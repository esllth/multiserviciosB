@{
    ViewData["Title"] = "Inicio";
    ViewData["FullBleed"] = true;
    Layout = "_Layout";
}

<section class="hero">
    <div class="home-hero">
        <img src="@Url.Content("~/images/Revista/Hero.png")"
             class="home-hero-image"
             alt="Trabajo tecnico de Multiservicio Bolívar" />

        <div class="home-hero-copy">
            <h1 class="hero-title">Multiservicio Bolívar</h1>
            <p class="hero-sub">Fabricacion, refrigeracion y mantenimiento industrial con una ejecución limpia y profesional.</p>
        </div>
    </div>
</section>

<section class="showcase" aria-label="Trabajos destacados">
    <div class="showcase-heading">
        <p class="showcase-kicker">Revista de trabajos</p>
        <h2>Soluciones industriales con acabado limpio.</h2>
    </div>

    <div class="showcase-grid">
        <article class="showcase-card showcase-card-featured">
            <img src="@Url.Content("~/images/Revista/Revista1.jpg")" alt="Proyecto tecnico terminado" class="showcase-img" loading="lazy" />
            <div class="showcase-card-body">
                <h3>Fabricacion a medida</h3>
                <p>Componentes industriales con precision, orden y acabado profesional.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">Solicitar cotizacion</a>
            </div>
        </article>

        <article class="showcase-card">
            <img src="@Url.Content("~/images/Revista/Revista5.jpg")" alt="Instalacion industrial" class="showcase-img" loading="lazy" />
            <div class="showcase-card-body">
                <h3>Instalacion tecnica</h3>
                <p>Montajes limpios para operacion continua y mantenimiento sencillo.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">Ver servicio</a>
            </div>
        </article>

        <article class="showcase-card">
            <img src="@Url.Content("~/images/Revista/Revista8.jpg")" alt="Detalle de fabricacion" class="showcase-img" loading="lazy" />
            <div class="showcase-card-body">
                <h3>Acabado industrial</h3>
                <p>Detalles funcionales pensados para resistencia, limpieza y durabilidad.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">Ver detalle</a>
            </div>
        </article>

        <article class="showcase-card">
            <img src="@Url.Content("~/images/Revista/Revista2.jpg")" alt="Servicio tecnico especializado" class="showcase-img" loading="lazy" />
            <div class="showcase-card-body">
                <h3>Servicio especializado</h3>
                <p>Diagnostico y ejecución con criterio tecnico en campo.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">Coordinar visita</a>
            </div>
        </article>

        <article class="showcase-card">
            <img src="@Url.Content("~/images/Revista/Revista10.png")" alt="Equipo industrial instalado" class="showcase-img" loading="lazy" />
            <div class="showcase-card-body">
                <h3>Equipos instalados</h3>
                <p>Integracion sobria para espacios de trabajo exigentes.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">Consultar</a>
            </div>
        </article>

        <article class="showcase-card">
            <img src="@Url.Content("~/images/Revista/Revista3.png")" alt="Proyecto de mantenimiento" class="showcase-img" loading="lazy" />
            <div class="showcase-card-body">
                <h3>Mantenimiento</h3>
                <p>Intervenciones ordenadas para conservar rendimiento y seguridad.</p>
                <a asp-area="Identity" asp-page="/Account/Login" class="showcase-link">Programar</a>
            </div>
        </article>
    </div>
</section>
