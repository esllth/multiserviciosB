@model IEnumerable<MultiservicioB.DTOs.EquipoDTO>

@{
    ViewData["Title"] = "Gestión de Equipos";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Gestión de Equipos</h1>
        <a asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Equipo
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Especificaciones</th>
                            <th>Estado</th>
                            <th>Cliente</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var equipo in Model)
                        {
                            <tr>
                                <td>@equipo.Nombre</td>
                                <td>@equipo.Categoria</td>
                                <td>@equipo.Especificaciones</td>
                                <td>
                                    @if (equipo.Estado == "Activo")
                                    {
                                        <span class="badge bg-success">@equipo.Estado</span>
                                    }
                                    else if (equipo.Estado == "En Mantenimiento")
                                    {
                                        <span class="badge bg-warning">@equipo.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@equipo.Estado</span>
                                    }
                                </td>
                                <td>@equipo.NombreCliente</td>
                                <td>
                                    <a asp-action="Editar" asp-route-id="@equipo.IdEquipo" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a asp-action="Eliminar" asp-route-id="@equipo.IdEquipo" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
