@model MultiservicioB.DTOs.EquipoDTO

@{
    ViewData["Title"] = "Eliminar Equipo";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3>Eliminar Equipo</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        ¿Está seguro que desea eliminar este equipo?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Nombre</dt>
                        <dd class="col-sm-9">@Model.Nombre</dd>

                        <dt class="col-sm-3">Categoría</dt>
                        <dd class="col-sm-9">@Model.Categoria</dd>

                        <dt class="col-sm-3">Especificaciones</dt>
                        <dd class="col-sm-9">@Model.Especificaciones</dd>

                        <dt class="col-sm-3">Estado</dt>
                        <dd class="col-sm-9">@Model.Estado</dd>

                        <dt class="col-sm-3">Cliente</dt>
                        <dd class="col-sm-9">@Model.NombreCliente</dd>
                    </dl>

                    <form asp-action="Eliminar" method="post">
                        <input type="hidden" asp-for="IdEquipo" />
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-action-cancel">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-action-delete">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
