@{
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="container mt-5">

    <!-- ENCABEZADO -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary site-heading">Panel de Administrador</h1>
        <p class="lead text-muted">Bienvenido, @User.Identity?.Name</p>
        <p>Gestiona todos los módulos del sistema desde aquí</p>
    </div>

    <!-- MÓDULOS DE NAVEGACIÓN -->
    <h4 class="mb-4">Módulos del Sistema</h4>

    <div class="row justify-content-center text-center g-4 mt-5">

        <!-- EMPLEADOS -->
        <div class="col-md-4">
            <a asp-controller="Empleados" asp-action="Index" class="text-decoration-none" aria-label="Ir a Gestión de personal">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Empleados.png"))" alt="Empleados" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Gestión de personal</h5>
                        <p class="card-text text-muted">Administra personal, roles y asignaciones</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- CLIENTES -->
        <div class="col-md-4">
            <a asp-controller="Cliente" asp-action="Index" class="text-decoration-none" aria-label="Ir a Gestión de clientes">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Cliente.png"))" alt="Clientes" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Gestión de Clientes</h5>
                        <p class="card-text text-muted">Administra clientes y sus solicitudes</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- SERVICIOS -->
        <div class="col-md-4">
            <a asp-controller="Servicios" asp-action="Servicios" class="text-decoration-none" aria-label="Ir a Gestión de servicios">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Fabricacion.png"))" alt="Servicios" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Gestión de servicios</h5>
                        <p class="card-text text-muted">Gestión de cotizaciones, ordenes de servicio y más</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- EQUIPOS -->
        <div class="col-md-4">
            <a asp-controller="Equipos" asp-action="Equipos" class="text-decoration-none" aria-label="Ir a Gestión de equipos">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Equipos.png"))" alt="Equipos" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Gestión de equipos</h5>
                        <p class="card-text text-muted">Inventario y mantenimiento de activos</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- MATERIALES -->
        <div class="col-md-4">
            <a asp-controller="Materiales" asp-action="Materiales" class="text-decoration-none" aria-label="Ir a Gestión de materiales">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Materiales.png"))" alt="Materiales" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Gestión de Materiales</h5>
                        <p class="card-text text-muted">Control de inventario y consumo</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Reportes -->
        <div class="col-md-4">
            <a asp-controller="Reportes" asp-action="Reportes" class="text-decoration-none" aria-label="Ir a Gestión de reportes">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <img src="@(Url.Content("~/images/Iconos/Reportes.png"))" alt="Reportes" class="icon-display-1" />
                        </div>
                        <h5 class="card-title text-dark">Gestión de reportes</h5>
                        <p class="card-text text-muted">Generar reportes</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

</div>

<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
</style>
