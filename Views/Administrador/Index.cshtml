@using System.Linq
@using MultiservicioB.ViewModels
@{
    ViewData["Title"] = "Administrador";
    var avisosTrabajoCompletado = (ViewBag.NotificacionesTrabajoCompletado as IEnumerable<NotificacionTrabajoCompletadoViewModel>
        ?? Enumerable.Empty<NotificacionTrabajoCompletadoViewModel>()).ToList();
    var compromisosCalendario = (ViewBag.CompromisosCalendario as IEnumerable<CompromisoCalendarioViewModel>
        ?? Enumerable.Empty<CompromisoCalendarioViewModel>()).ToList();
    var reporteCotizaciones = (int)(ViewBag.ReporteCotizaciones ?? 0);
    var reporteOrdenes = (int)(ViewBag.ReporteOrdenes ?? 0);
    var reporteClientes = (int)(ViewBag.ReporteClientes ?? 0);
    var reporteMateriales = (int)(ViewBag.ReporteMateriales ?? 0);
}

<section class="container py-5 dashboard-page">
    <div class="dashboard-heading">
        <span class="dashboard-eyebrow">Panel principal</span>
        <h1 class="site-heading">Administrador</h1>
        <p>Resumen visual de la actividad y los indicadores del sistema.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (avisosTrabajoCompletado.Any())
    {
        <div class="admin-work-alert mb-4">
            <div class="admin-work-alert-head">
                <span class="admin-work-alert-icon">
                    <i class="bi bi-bell"></i>
                </span>
                <div>
                    <span class="dashboard-eyebrow">Avisos pendientes</span>
                    <h2>T&eacute;cnico complet&oacute; el trabajo</h2>
                </div>
            </div>

            <div class="admin-work-alert-list">
                @foreach (var aviso in avisosTrabajoCompletado)
                {
                    <div class="admin-work-alert-item">
                        <div class="admin-work-alert-content">
                            <strong>Orden #@aviso.IdOrden</strong>
                            <p>@(aviso.Mensaje ?? "El técnico reportó que el trabajo está listo para cierre administrativo.")</p>
                            <small>
                                @(aviso.Cliente ?? "Cliente no disponible")
                                @if (!string.IsNullOrWhiteSpace(aviso.Tecnico))
                                {
                                    <span> - @aviso.Tecnico</span>
                                }
                                @if (aviso.Fecha.HasValue)
                                {
                                    <span> - @aviso.Fecha.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                }
                            </small>
                        </div>
                        <div class="admin-work-alert-actions">
                            <a href="@Url.Action("Detalle", "Tecnicos", new { id = aviso.IdOrden })" class="btn btn-action-view btn-sm">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            @if (aviso.EstadoOrden == "En Progreso" || aviso.EstadoOrden == "EnProgreso")
                            {
                                <form action="@Url.Action("CerrarOrdenDesdeAviso", "Tecnicos", new { id = aviso.IdOrden, volverDashboard = true })" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-action-save btn-sm">
                                        <i class="bi bi-check-circle"></i> Cerrar orden
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="admin-work-alert mb-4" id="eventos-programados">
        <div class="admin-work-alert-head">
            <span class="admin-work-alert-icon">
                <i class="bi bi-calendar-event"></i>
            </span>
            <div>
                <span class="dashboard-eyebrow">Calendario</span>
                <h2>Compromisos programados</h2>
            </div>
            <a asp-controller="Tecnicos" asp-action="Index" class="btn btn-action-view ms-auto">
                <i class="bi bi-calendar-week"></i> Ver eventos programados
            </a>
        </div>

        @if (compromisosCalendario.Any())
        {
            <div class="admin-work-alert-list">
                @foreach (var compromiso in compromisosCalendario)
                {
                    <div class="admin-work-alert-item">
                        <div>
                            <strong>@compromiso.FechaCompromiso.ToString("dd/MM/yyyy hh:mm tt") - Orden #@compromiso.IdOrden</strong>
                            <p>@compromiso.TipoServicio</p>
                            <small>
                                @compromiso.Cliente
                                @if (!string.IsNullOrWhiteSpace(compromiso.Tecnico))
                                {
                                    <span> - @compromiso.Tecnico</span>
                                }
                                else
                                {
                                    <span> - Sin técnico asignado</span>
                                }
                                <span> - @(compromiso.Confirmado ? "Confirmado" : "Pendiente de confirmar")</span>
                            </small>
                        </div>
                        <div class="admin-work-alert-actions">
                            <a asp-controller="Tecnicos" asp-action="Detalle" asp-route-id="@compromiso.IdOrden" class="btn btn-action-view btn-sm">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a asp-controller="Tecnicos" asp-action="Administrar" asp-route-id="@compromiso.IdOrden" class="btn btn-action-schedule btn-sm">
                                <i class="bi bi-clock"></i> Cambiar fecha
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="mb-0 text-muted">No hay compromisos programados.</p>
        }
    </div>

    <section class="dashboard-report-section" aria-labelledby="dashboard-report-title">
        <div class="dashboard-report-heading">
            <div><span class="dashboard-eyebrow">Indicadores</span><h2 id="dashboard-report-title">Resumen del sistema</h2></div>
            <a asp-controller="Reportes" asp-action="Index" class="btn btn-action-view"><i class="bi bi-graph-up-arrow"></i> Ver reportes</a>
        </div>
        <div class="dashboard-report-grid">
            <article class="dashboard-report-card"><i class="bi bi-file-earmark-text"></i><span>Cotizaciones</span><strong>@reporteCotizaciones</strong><small>Solicitudes registradas</small></article>
            <article class="dashboard-report-card"><i class="bi bi-clipboard-check"></i><span>Órdenes</span><strong>@reporteOrdenes</strong><small>Órdenes de servicio</small></article>
            <article class="dashboard-report-card"><i class="bi bi-people"></i><span>Clientes</span><strong>@reporteClientes</strong><small>Clientes registrados</small></article>
            <article class="dashboard-report-card"><i class="bi bi-box-seam"></i><span>Materiales</span><strong>@reporteMateriales</strong><small>Artículos en inventario</small></article>
        </div>
    </section>
</section>
