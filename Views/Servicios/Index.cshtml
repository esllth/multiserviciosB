@model IEnumerable<MultiservicioB.DTOs.TipoServicioDTO>

@{
    ViewData["Title"] = "Tipos de Servicio";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Tipos de Servicio</h1>
        <a asp-action="Crear" class="btn btn-action-create">
            <i class="bi bi-plus-circle"></i> Nuevo Tipo de Servicio
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Estado</th>
                            <th>Visita</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var servicio in Model)
                        {
                            <tr>
                                <td>@servicio.Nombre</td>
                                <td>
                                    @if (servicio.Estado == "Activo")
                                    {
                                        <span class="idx-badge @EstadoBadge.Servicio("Activo")">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="idx-badge @EstadoBadge.Servicio("Inactivo")">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    @if (servicio.RequiereVisita)
                                    {
                                        <span class="idx-badge @EstadoBadge.General("Obligatoria")">Obligatoria</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No requerida</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Editar" asp-route-id="@servicio.Id"
                                       class="btn btn-sm btn-action-edit">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <form asp-action="Eliminar" method="post" class="d-inline"
                                          data-confirm-service="true"
                                          data-service-name="@servicio.Nombre">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@servicio.Id" />
                                        <button type="submit" class="btn btn-sm btn-action-delete">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="confirmarEliminarServicioModal" tabindex="-1"
     aria-labelledby="confirmarEliminarServicioTitulo" aria-describedby="confirmarEliminarServicioTexto" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="confirmarEliminarServicioTitulo">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Eliminar tipo de servicio
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="confirmarEliminarServicioTexto">
                <p class="mb-1">¿Está seguro de eliminar este tipo de servicio?</p>
                <p class="text-muted mb-0"><strong id="nombreServicioEliminar"></strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-action-cancel" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-action-delete" id="aceptarEliminarServicio">
                    <i class="bi bi-trash me-1"></i>Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modalElement = document.getElementById('confirmarEliminarServicioModal');
            const nombreElement = document.getElementById('nombreServicioEliminar');
            const confirmButton = document.getElementById('aceptarEliminarServicio');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            let pendingForm = null;

            document.querySelectorAll('form[data-confirm-service]').forEach((form) => {
                form.addEventListener('submit', (event) => {
                    if (form.dataset.confirmed === 'true') {
                        return;
                    }

                    event.preventDefault();
                    pendingForm = form;
                    nombreElement.textContent = form.dataset.serviceName || '';
                    modal.show();
                });
            });

            confirmButton.addEventListener('click', () => {
                if (!pendingForm) {
                    return;
                }

                pendingForm.dataset.confirmed = 'true';
                modal.hide();
                pendingForm.requestSubmit();
            });

            modalElement.addEventListener('hidden.bs.modal', () => {
                pendingForm = null;
                nombreElement.textContent = '';
            });
        });
    </script>
}

