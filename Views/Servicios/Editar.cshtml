@model MultiservicioB.DTOs.TipoServicioDTO

@{
    ViewData["Title"] = "Editar Tipo de Servicio";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Editar Tipo de Servicio</h1>
        <a asp-action="Index" class="btn btn-action-cancel">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold"></label>
                    <input asp-for="Nombre" class="form-control"
                           placeholder="Ej: Mantenimiento Preventivo, Reparación..." />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label fw-bold"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="Activo">Activo</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RequiereVisita" class="form-check-input" />
                    <label asp-for="RequiereVisita" class="form-check-label"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-action-save">
                        <i class="bi bi-check-circle"></i> Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-action-cancel">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


