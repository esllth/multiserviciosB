@model MultiservicioB.ViewModels.SolicitarCotizacionViewModel

@{
    ViewData["Title"] = "Solicitar cotizacion";
    var tiposServicio = ViewBag.TiposServicio as IEnumerable<MultiservicioB.Models.TipoServicio>
        ?? Enumerable.Empty<MultiservicioB.Models.TipoServicio>();
    var tipoSeleccionado = ViewBag.TipoServicioSeleccionado as int?;
}

<section class="container py-5">
    <h1 class="site-heading mb-4">Solicitar cotizacion</h1>
    <div class="card">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="TipoServicioId" class="form-label"></label>
                    <select asp-for="TipoServicioId" class="form-select" id="tipoServicioSelect">
                        <option value="">Seleccione un servicio</option>
                        @foreach (var tipo in tiposServicio)
                        {
                            <option value="@tipo.Id" data-requiere-visita="@tipo.RequiereVisita.ToString().ToLowerInvariant()" selected="@(tipoSeleccionado == tipo.Id)">
                                @tipo.Nombre
                            </option>
                        }
                    </select>
                    <span asp-validation-for="TipoServicioId" class="text-danger"></span>
                </div>
                <div class="mb-3" id="fechaVisitaGroup">
                    <label asp-for="FechaVisitaSolicitada" class="form-label"></label>
                    <input asp-for="FechaVisitaSolicitada" class="form-control" type="datetime-local" />
                    <span asp-validation-for="FechaVisitaSolicitada" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FotosReferencia" class="form-label"></label>
                    <input asp-for="FotosReferencia"
                           class="form-control"
                           type="file"
                           accept="image/jpeg,image/png,image/webp"
                           multiple />
                    <div class="form-text">
                        Opcional. Puede adjuntar hasta 2 fotografias JPEG, PNG o WebP, de maximo 5 MB cada una.
                    </div>
                    <span asp-validation-for="FotosReferencia" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-action-cancel">Cancelar</a>
                    <button type="submit" class="btn btn-action-save">Enviar solicitud</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (() => {
            const select = document.getElementById('tipoServicioSelect');
            const group = document.getElementById('fechaVisitaGroup');
            const toggle = () => {
                const option = select.options[select.selectedIndex];
                group.style.display = option?.dataset.requiereVisita === 'true' ? '' : 'none';
            };
            select.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
