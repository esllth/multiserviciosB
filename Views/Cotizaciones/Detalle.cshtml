@model MultiservicioB.Models.Cotizacion
@using System.Globalization

@{
    ViewData["Title"] = "Detalle de cotización";
    var ordenServicio = ViewBag.OrdenServicio as MultiservicioB.Models.OrdenServicio;
    var estadoCotizacion = Model.EstadoCotizacion?.Nombre;
    var compromisoEditable = User.IsInRole("Cliente") &&
        estadoCotizacion == "Aprobada" &&
        ordenServicio != null &&
        !ordenServicio.CompromisoConfirmado;
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Cotización #@Model.IdCotizacion</h1>
        <a asp-action="Index" class="btn btn-action-cancel">Volver</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
    }

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Cliente</dt>
                <dd class="col-sm-8">@Model.Cliente?.Nombre @Model.Cliente?.Apellidos</dd>

                <dt class="col-sm-4">Tipo de servicio</dt>
                <dd class="col-sm-8">@Model.TipoServicio?.Nombre</dd>

                <dt class="col-sm-4">Solicitud</dt>
                <dd class="col-sm-8">@Model.Descripcion</dd>

                <dt class="col-sm-4">Fecha</dt>
                <dd class="col-sm-8">@Model.FechaSolicitud?.ToString("dd/MM/yyyy hh:mm tt")</dd>

                @if (Model.FechaVisitaSolicitada.HasValue)
                {
                    <dt class="col-sm-4">Fecha solicitada para visita</dt>
                    <dd class="col-sm-8">@Model.FechaVisitaSolicitada.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>
                }

                @if (ordenServicio?.FechaCompromiso != null)
                {
                    <dt class="col-sm-4">Compromiso</dt>
                    <dd class="col-sm-8">
                        @ordenServicio.FechaCompromiso.Value.ToString("dd/MM/yyyy hh:mm tt")
                        @if (ordenServicio.CompromisoConfirmado)
                        {
                            <span class="idx-badge @EstadoBadge.General("Confirmado") ms-2">Confirmado</span>
                        }
                        else
                        {
                            <span class="idx-badge @EstadoBadge.General("Pendiente de confirmación") ms-2">Pendiente de confirmacion</span>
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace((string?)ViewBag.DireccionServicio))
                {
                    <dt class="col-sm-4">Dirección del servicio</dt>
                    <dd class="col-sm-8">@ViewBag.DireccionServicio</dd>
                }
                else if (!string.IsNullOrWhiteSpace((string?)ViewBag.EnlaceServicio))
                {
                    <dt class="col-sm-4">Ubicación del servicio</dt>
                    <dd class="col-sm-8"><a href="@ViewBag.EnlaceServicio" target="_blank" rel="noopener">Ver ubicación en el mapa</a></dd>
                }

                @if (ordenServicio != null)
                {
                    <dt class="col-sm-4">Técnico asignado</dt>
                    <dd class="col-sm-8">
                        @(ordenServicio.Empleado != null
                            ? $"{ordenServicio.Empleado.NombreEmpleado} {ordenServicio.Empleado.ApellidosEmpleado}"
                            : "Sin asignar")
                    </dd>
                }

                <dt class="col-sm-4">Monto presupuestado (CRC)</dt>
                <dd class="col-sm-8">
                    @(Model.MontoPresupuesto.HasValue
                        ? $"CRC {Model.MontoPresupuesto.Value.ToString("N2", CultureInfo.GetCultureInfo("es-CR"))}"
                        : "Pendiente de evaluacion")
                </dd>

                @if (Model.RequiereAdelanto && Model.PorcentajeAdelanto.HasValue && Model.MontoPresupuesto.HasValue)
                {
                    var adelanto = Model.MontoPresupuesto.Value * Model.PorcentajeAdelanto.Value / 100m;
                    <dt class="col-sm-4">Adelanto solicitado</dt>
                    <dd class="col-sm-8">
                        @Model.PorcentajeAdelanto% - CRC @adelanto.ToString("N2", CultureInfo.GetCultureInfo("es-CR"))
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.FormaPagoAceptada))
                {
                    <dt class="col-sm-4">Forma de pago aceptada</dt>
                    <dd class="col-sm-8">
                        @(Model.FormaPagoAceptada == "Completo"
                            ? "Pago completo por adelantado"
                            : "Pago del adelanto acordado y saldo final pendiente")
                    </dd>
                }

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8"><span class="idx-badge @EstadoBadge.Cotizacion(estadoCotizacion)">@estadoCotizacion</span></dd>

                @if (Model.FechaAprobacion.HasValue)
                {
                    <dt class="col-sm-4">Aprobada el</dt>
                    <dd class="col-sm-8">@Model.FechaAprobacion.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>
                }

                @if (Model.FechaRechazo.HasValue)
                {
                    <dt class="col-sm-4">Rechazada el</dt>
                    <dd class="col-sm-8">@Model.FechaRechazo.Value.ToString("dd/MM/yyyy hh:mm tt")</dd>

                    <dt class="col-sm-4">Motivo del rechazo</dt>
                    <dd class="col-sm-8">@Model.MotivoRechazo</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ComentarioRevisionAdministrador))
                {
                    <dt class="col-sm-4">Comentario de revisión</dt>
                    <dd class="col-sm-8">@Model.ComentarioRevisionAdministrador</dd>
                }

            </dl>
        </div>
    </div>

    @if (Model.Fotos.Count > 0)
    {
        <div class="card mt-3">
            <div class="card-body">
                <h2 class="h5 mb-3">Fotografías de referencia</h2>
                <div class="quote-photo-grid">
                    @foreach (var foto in Model.Fotos.OrderBy(f => f.FechaCarga))
                    {
                        <a asp-action="Foto"
                           asp-route-id="@foto.IdFotoCotizacion"
                           target="_blank"
                           rel="noopener"
                           class="quote-photo-link"
                           title="Abrir @foto.NombreOriginal">
                            <img src="@Url.Action("Foto", new { id = foto.IdFotoCotizacion })"
                                 alt="Referencia para la cotización"
                                 class="quote-photo" />
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @{
        var documentosCotizacion = ViewBag.DocumentosCotizacion as List<MultiservicioB.Models.DocumentoCotizacion>
            ?? new List<MultiservicioB.Models.DocumentoCotizacion>();
        var puedeGestionarDocumentos = User.IsInRole("Administrador")
            && estadoCotizacion == "Evaluada"
            && ordenServicio == null;
    }

    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Documentos de aceptación</h2>
            <span class="idx-badge @EstadoBadge.General("Documentos adjuntos")">@documentosCotizacion.Count</span>
        </div>
        <div class="card-body">
            @if (puedeGestionarDocumentos)
            {
                <form asp-controller="CotizacionDocumentos" asp-action="Subir" method="post" enctype="multipart/form-data" class="row g-2 mb-3">
                    <input type="hidden" name="cotizacionId" value="@Model.IdCotizacion" />
                    <input type="hidden" name="tipoDocumento" value="CotizacionFirmada" />
                    <div class="col-md-9">
                        <label class="form-label">PDF</label>
                        <input type="file" name="archivo" class="form-control" accept="application/pdf,.pdf" required />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-action-upload w-100">Adjuntar PDF</button>
                    </div>
                </form>
            }

            @if (documentosCotizacion.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Documento</th><th>Tipo</th><th>Fecha</th><th>Estado</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var documento in documentosCotizacion)
                        {
                            <tr>
                                <td>@documento.NombreOriginal</td>
                                <td>@(documento.TipoDocumento == "CotizacionFirmada" ? "Cotización firmada" : "Comprobante de pago")</td>
                                <td>@documento.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(documento.EsReemplazable ? "Editable" : "Contractual bloqueado")</td>
                                <td class="text-end">
                                    <a asp-controller="CotizacionDocumentos" asp-action="Descargar" asp-route-id="@documento.IdDocumento" class="btn btn-sm btn-action-view">Descargar</a>
                                    @if (puedeGestionarDocumentos && documento.EsReemplazable)
                                    {
                                        <form asp-controller="CotizacionDocumentos" asp-action="Eliminar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@documento.IdDocumento" />
                                            <input type="hidden" name="cotizacionId" value="@Model.IdCotizacion" />
                                            <button type="submit" class="btn btn-sm btn-action-delete" onclick="return confirm('¿Eliminar este documento?')">Eliminar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (puedeGestionarDocumentos)
                {
                    <form asp-controller="CotizacionAprobacion" asp-action="Aprobar" method="post" class="mt-3">
                        <input type="hidden" name="cotizacionId" value="@Model.IdCotizacion" />
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="confirmarDocumentos" value="true" required />
                            <label class="form-check-label">Confirmo que revisé al menos un PDF válido y apruebo esta cotización.</label>
                        </div>
                        <button type="submit" class="btn btn-action-save">Aprobar manualmente y crear orden</button>
                    </form>

                    <form asp-controller="CotizacionAprobacion" asp-action="Rechazar" method="post" class="mt-3">
                        <input type="hidden" name="cotizacionId" value="@Model.IdCotizacion" />
                        <label class="form-label">Motivo del rechazo</label>
                        <textarea name="motivo" class="form-control mb-2" maxlength="1000" required></textarea>
                        <button type="submit" class="btn btn-action-cancel-operation">Rechazar cotización</button>
                    </form>
                }
            }
            else
            {
                <div class="alert alert-warning mb-0">Debe cargar al menos un PDF para habilitar la aprobación manual.</div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        @if (User.IsInRole("Administrador") || User.IsInRole("Secretaria") || User.IsInRole("Empleado"))
        {
            <a asp-action="PerfilCliente" asp-route-id="@Model.ClienteId" class="btn btn-action-view">Ver perfil del cliente</a>
        }
        @if (Model.MontoPresupuesto.HasValue)
        {
            <a asp-action="DescargarPdf" asp-route-id="@Model.IdCotizacion" class="btn btn-action-view">
                Descargar PDF
            </a>
        }
        @* La aprobación y el rechazo manual son realizados por el administrador con evidencia PDF. *@
        @if (User.IsInRole("Cliente") && compromisoEditable)
        {
            <a asp-action="AgendarCita" asp-route-id="@Model.IdCotizacion" class="btn btn-action-save">
                @(string.IsNullOrWhiteSpace(Model.FormaPagoAceptada) ? "Agendar cita" : "Editar fecha y ubicación")
            </a>
        }
        @if (User.IsInRole("Cliente") && Model.EstadoCotizacion?.Nombre == "Pendiente")
        {
            <a asp-action="Editar" asp-route-id="@Model.IdCotizacion" class="btn btn-action-edit">
                Editar cotización
            </a>
        }
        @if (User.IsInRole("Administrador") && ordenServicio != null)
        {
            <a asp-controller="Tecnicos" asp-action="Administrar" asp-route-id="@ordenServicio.IdOrden" class="btn btn-action-edit">
                Asignar técnico y confirmar
            </a>
        }
    </div>

    @if (User.IsInRole("Administrador") && ViewBag.EvaluacionCotizacion is MultiservicioB.ViewModels.EvaluarCotizacionViewModel evaluacion)
    {
        <div id="evaluacion" class="card mt-4">
            <div class="card-header">
                <h2 class="h5 mb-0">Evaluar cotización</h2>
            </div>
            <div class="card-body">
                <partial name="_FormularioEvaluarCotizacion" model="evaluacion" />
            </div>
        </div>
    }
</section>
