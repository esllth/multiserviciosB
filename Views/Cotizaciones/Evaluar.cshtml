@model MultiservicioB.ViewModels.EvaluarCotizacionViewModel

@{
    ViewData["Title"] = "Evaluar cotización";
}

<section class="container py-5">
    <h1 class="site-heading mb-4">Evaluar cotización #@Model.IdCotizacion</h1>
    <div class="card">
        <div class="card-body">
            <form method="post">
                <input asp-for="IdCotizacion" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="MontoPresupuesto" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        <input asp-for="MontoPresupuesto"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               inputmode="decimal"
                               placeholder="Ej: 125000.00" />
                    </div>
                    <div class="form-text">Ingrese el monto en colones costarricenses (CRC).</div>
                    <span asp-validation-for="MontoPresupuesto" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Detalle" asp-route-id="@Model.IdCotizacion" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar evaluación</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
