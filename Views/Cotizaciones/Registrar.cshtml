@model MultiservicioB.ViewModels.RegistrarCotizacionAdministrativaViewModel

@{
    ViewData["Title"] = "Registrar cotización";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="site-heading mb-1">Registrar cotización</h1>
            <p class="text-muted mb-0">Capture una solicitud recibida de un cliente registrado.</p>
        </div>
        <a asp-action="Index" class="btn btn-action-cancel"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body p-4">
                    <form asp-action="Registrar" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="IdentificadorCliente" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-search"></i></span>
                                <input asp-for="IdentificadorCliente" class="form-control"
                                       placeholder="Cédula, correo electrónico o teléfono" autocomplete="off" />
                            </div>
                            <div class="form-text">Solo se buscarán clientes activos.</div>
                            <span asp-validation-for="IdentificadorCliente" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TipoServicioId" class="form-label fw-semibold"></label>
                            <select asp-for="TipoServicioId" class="form-select">
                                <option value="">Seleccione un servicio</option>
                                @foreach (var tipo in ViewBag.TiposServicio)
                                {
                                    <option value="@tipo.Id" selected="@(Model.TipoServicioId == tipo.Id)">@tipo.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="TipoServicioId" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4"
                                      placeholder="Detalle de la solicitud del cliente"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="FechaVisitaSolicitada" class="form-label fw-semibold"></label>
                            <input asp-for="FechaVisitaSolicitada" asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control" type="datetime-local" />
                            <span asp-validation-for="FechaVisitaSolicitada" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-action-cancel">Cancelar</a>
                            <button type="submit" class="btn btn-action-save">
                                <i class="bi bi-check-circle me-1"></i>Registrar cotización
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
