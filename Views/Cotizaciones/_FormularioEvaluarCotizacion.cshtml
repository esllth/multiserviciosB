@model MultiservicioB.ViewModels.EvaluarCotizacionViewModel

<form asp-controller="Cotizaciones" asp-action="Evaluar" asp-route-id="@Model.IdCotizacion" method="post">
    <input asp-for="IdCotizacion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="MontoPresupuesto" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="MontoPresupuesto"
                   class="form-control"
                   type="number"
                   min="0.01"
                   step="0.01"
                   inputmode="decimal"
                   placeholder="Ej: 125000.00" />
        </div>
        <div class="form-text">Ingrese el monto en colones costarricenses (CRC).</div>
        <span asp-validation-for="MontoPresupuesto" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RequiereAdelanto" class="form-check-input" />
        <label asp-for="RequiereAdelanto" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="PorcentajeAdelanto" class="form-label"></label>
        <select asp-for="PorcentajeAdelanto" class="form-select">
            <option value="">Sin adelanto</option>
            <option value="20">20%</option>
            <option value="30">30%</option>
            <option value="50">50%</option>
        </select>
        <span asp-validation-for="PorcentajeAdelanto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ComentarioRevisionAdministrador" class="form-label"></label>
        <textarea asp-for="ComentarioRevisionAdministrador" class="form-control" rows="3"></textarea>
        <span asp-validation-for="ComentarioRevisionAdministrador" class="text-danger"></span>
    </div>

    <div class="form-check mb-3 quote-contact-check">
        <input asp-for="ContactoCliente" class="form-check-input" />
        <label asp-for="ContactoCliente" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-action-save">Guardar evaluación</button>
</form>
