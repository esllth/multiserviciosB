@model MultiservicioB.ViewModels.SolicitarCotizacionViewModel
@{
    ViewData["Title"] = "Editar cotización";
    var tiposServicio = ViewBag.TiposServicio as IEnumerable<MultiservicioB.Models.TipoServicio>
        ?? Enumerable.Empty<MultiservicioB.Models.TipoServicio>();
    var tipoSeleccionado = ViewBag.TipoServicioSeleccionado as int?;
}

<section class="container py-5">
    <h1 class="site-heading mb-4">Editar cotización</h1>
    <div class="card">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="TipoServicioId" class="form-label"></label>
                    <select asp-for="TipoServicioId" class="form-select" id="tipoServicioSelect">
                        <option value="">Seleccione un servicio</option>
                        @foreach (var tipo in tiposServicio)
                        {
                            <option value="@tipo.Id" data-requiere-visita="@tipo.RequiereVisita.ToString().ToLowerInvariant()" selected="@(tipoSeleccionado == tipo.Id)">
                                @tipo.Nombre
                            </option>
                        }
                    </select>
                    <span asp-validation-for="TipoServicioId" class="text-danger"></span>
                </div>
                <div class="mb-3" id="fechaVisitaGroup">
                    <label asp-for="FechaVisitaSolicitada" class="form-label"></label>
                    <input asp-for="FechaVisitaSolicitada" class="form-control" type="datetime-local" />
                    <span asp-validation-for="FechaVisitaSolicitada" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="500"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                @{ var fotosExistentes = ViewBag.FotosExistentes as IEnumerable<MultiservicioB.Models.FotoCotizacion> ?? Enumerable.Empty<MultiservicioB.Models.FotoCotizacion>(); }
                @if (fotosExistentes.Any())
                {
                    <div class="mb-3">
                        <label class="form-label">Fotografías guardadas</label>
                        <div class="quote-photo-grid">
                            @foreach (var foto in fotosExistentes)
                            {
                                <div>
                                    <a asp-action="Foto" asp-route-id="@foto.IdFotoCotizacion" target="_blank" rel="noopener">
                                        <img src="@Url.Action("Foto", new { id = foto.IdFotoCotizacion })"
                                             alt="@foto.NombreOriginal"
                                             class="quote-photo" />
                                    </a>
                                    <form asp-action="EliminarFoto" method="post" class="mt-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@foto.IdFotoCotizacion" />
                                        <input type="hidden" name="cotizacionId" value="@ViewContext.RouteData.Values["id"]" />
                                        <button type="submit" class="btn btn-sm btn-action-cancel-operation"
                                                onclick="return confirm('¿Eliminar esta fotografía?');">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="mb-3">
                    <label asp-for="FotosReferencia" class="form-label">Agregar fotografías de referencia</label>
                    <input asp-for="FotosReferencia"
                           class="form-control"
                           type="file"
                           accept="image/jpeg,image/png,image/webp"
                           multiple />
                    <div class="form-text">
                        Opcional. El máximo total es de 2 fotografías por cotización, con 5 MB por archivo.
                    </div>
                    <span asp-validation-for="FotosReferencia" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Detalle" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-action-cancel-operation">Cancelar</a>
                    <button type="submit" class="btn btn-action-save">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (() => {
            const select = document.getElementById('tipoServicioSelect');
            const group = document.getElementById('fechaVisitaGroup');
            const toggle = () => {
                const option = select.options[select.selectedIndex];
                group.style.display = option?.dataset.requiereVisita === 'true' ? '' : 'none';
            };
            select.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
