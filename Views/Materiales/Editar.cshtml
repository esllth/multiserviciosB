@model MultiservicioB.DTOs.MaterialDTO

@{
    ViewData["Title"] = "Editar Material";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3>Editar Material</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="IdMaterial" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Categoria" class="form-label"></label>
                                <select asp-for="Categoria" class="form-select">
                                    <option value="">Seleccione una categoría...</option>
                                    <option>Herramientas</option><option>Tornillos y fijaciones</option><option>Láminas</option>
                                    <option>Tuberías</option><option>Material eléctrico</option><option>Pintura</option>
                                    <option>Soldadura</option><option>Repuestos</option><option>Consumibles</option><option>Otros</option>
                                </select>
                                <span asp-validation-for="Categoria" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Codigo" class="form-label"></label>
                                <input asp-for="Codigo" class="form-control" readonly />
                                <div class="form-text">Código automático permanente del material.</div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UnidadMedida" class="form-label"></label>
                                <select asp-for="UnidadMedida" class="form-select">
                                    <option value="">Seleccione...</option>
                                    <option value="Unidad">Unidad</option>
                                    <option value="Metro">Metro</option>
                                    <option value="Litro">Litro</option>
                                    <option value="Kilogramo">Kilogramo</option>
                                    <option value="Caja">Caja</option>
                                    <option value="Paquete">Paquete</option>
                                </select>
                                <span asp-validation-for="UnidadMedida" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PrecioUnitario" class="form-label"></label>
                                <input asp-for="PrecioUnitario" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StockActual" class="form-label"></label>
                                <input asp-for="StockActual" class="form-control" type="number" />
                                <span asp-validation-for="StockActual" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="StockMinimo" class="form-label"></label>
                                <input asp-for="StockMinimo" class="form-control" type="number" />
                                <span asp-validation-for="StockMinimo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-action-cancel">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-action-save">
                                <i class="bi bi-save"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
