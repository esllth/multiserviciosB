@model MultiservicioB.ViewModels.MaterialHistorialViewModel

@{
    ViewData["Title"] = "Historial de material";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="site-heading mb-1">Historial de @Model.Material.Nombre</h1>
            <p class="text-muted mb-0">Stock actual: <strong>@Model.Material.StockActual @Model.Material.UnidadMedida</strong></p>
        </div>
        <a asp-action="Index" class="btn btn-action-cancel"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Movimientos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Fecha de asignación</th><th>Orden</th><th>Cliente</th><th>Cantidad</th><th>Estado</th><th>Costo</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Movimientos)
                        {
                            <tr>
                                <td>@item.FechaRegistro?.ToString("dd/MM/yyyy hh:mm tt")</td>
                                <td><a asp-controller="Tecnicos" asp-action="Detalle" asp-route-id="@item.OrdenId">#@item.OrdenId</a></td>
                                <td>@item.NombreCliente</td>
                                <td>@item.CantidadUsada @item.UnidadMedida</td>
                                <td><span class="idx-badge @EstadoBadge.OrdenServicio(item.EstadoOrden)">@item.EstadoOrden</span></td>
                                <td>₡@item.CostoTotal.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Este material todavía no ha sido asignado a órdenes de servicio.</p>
            }
        </div>
    </div>
</section>
