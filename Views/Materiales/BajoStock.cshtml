@model IEnumerable<MultiservicioB.DTOs.MaterialDTO>

@{ ViewData["Title"] = "Revista de bajo stock"; }

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="site-heading mb-1">Revista de materiales por reabastecer</h1>
            <p class="text-muted mb-0">Materiales bajo el mínimo, priorizados según su uso en órdenes completadas.</p>
        </div>
        <a asp-action="Index" class="btn btn-action-cancel"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>No hay materiales con bajo stock.</div>
    }
    else
    {
        <div class="row g-4">
        @foreach (var material in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <span class="idx-badge @EstadoBadge.Material("Bajo stock")">Bajo stock</span>
                            <span class="badge text-bg-light">@(material.Categoria ?? "Sin categoría")</span>
                        </div>
                        <h2 class="h5 mb-1">@material.Nombre</h2>
                        <p class="text-muted small mb-3">@(material.Codigo ?? "Sin código") · @material.UnidadMedida</p>
                        <div class="row g-2 text-center mb-3">
                            <div class="col-4"><div class="border rounded p-2"><strong class="d-block">@material.StockActual</strong><small>Actual</small></div></div>
                            <div class="col-4"><div class="border rounded p-2"><strong class="d-block">@material.StockMinimo</strong><small>Mínimo</small></div></div>
                            <div class="col-4"><div class="border rounded p-2"><strong class="d-block">@material.TotalOrdenesUtilizado</strong><small>Órdenes</small></div></div>
                        </div>
                        <p class="small mb-2"><strong>Uso acumulado:</strong> @material.CantidadTotalUtilizada.ToString("N2") @material.UnidadMedida</p>
                        <div class="small mb-3">
                            <strong>Utilizado en:</strong>
                            @if (material.UltimasOrdenesUtilizadas.Any())
                            {
                                @foreach (var ordenId in material.UltimasOrdenesUtilizadas)
                                {
                                    <a asp-controller="Tecnicos" asp-action="Detalle" asp-route-id="@ordenId" class="badge text-bg-light text-decoration-none">#@ordenId</a>
                                }
                            }
                            else { <span class="text-muted">Sin órdenes completadas</span> }
                        </div>
                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Historial" asp-route-id="@material.IdMaterial" class="btn btn-sm btn-action-view flex-grow-1"><i class="bi bi-clock-history me-1"></i>Ver historial</a>
                            @if (User.IsInRole("Administrador"))
                            { <a asp-action="Editar" asp-route-id="@material.IdMaterial" class="btn btn-sm btn-action-edit" title="Actualizar stock"><i class="bi bi-box-arrow-in-up"></i></a> }
                        </div>
                    </div>
                </article>
            </div>
        }
        </div>
    }
</section>
