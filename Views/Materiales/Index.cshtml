@model IEnumerable<MultiservicioB.DTOs.MaterialDTO>

@{
    ViewData["Title"] = "Gestión de Materiales";
}

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="site-heading">Gestión de Materiales</h1>
        <div>
            <a asp-action="BajoStock" class="btn btn-action-view me-2">
                <i class="bi bi-exclamation-triangle"></i> Ver Bajo Stock
            </a>
            @if (User.IsInRole("Administrador") || User.IsInRole("Secretaria"))
            {
                <a asp-action="Crear" class="btn btn-action-create">
                    <i class="bi bi-plus-circle"></i> Nuevo Material
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="tablaMateriales" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Descripción</th>
                            <th>Unidad</th>
                            <th>Stock Actual</th>
                            <th>Stock Mínimo</th>
                            <th>Precio Unitario</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var material in Model)
                        {
                            <tr class="@(material.EnStockCritico ? "table-warning" : "")">
                                <td>@material.Codigo</td>
                                <td><strong>@material.Nombre</strong></td>
                                <td>@material.Categoria</td>
                                <td>@material.Descripcion</td>
                                <td>@material.UnidadMedida</td>
                                <td class="@(material.EnStockCritico ? "text-danger fw-bold" : "")">@material.StockActual</td>
                                <td>@material.StockMinimo</td>
                                <td>₡@material.PrecioUnitario?.ToString("N2")</td>
                                <td>
                                    @if (material.EnStockCritico)
                                    {
                                        <span class="idx-badge @EstadoBadge.Material("Stock crítico")">
                                            <i class="bi bi-exclamation-triangle"></i> Stock Crítico
                                        </span>
                                    }
                                    else if (material.Estado == "Activo")
                                    {
                                        <span class="idx-badge @EstadoBadge.Material(material.Estado)">@material.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="idx-badge @EstadoBadge.Material(material.Estado)">@material.Estado</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Editar" asp-route-id="@material.IdMaterial" class="btn btn-sm btn-action-edit" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Eliminar" asp-route-id="@material.IdMaterial" class="btn btn-sm btn-action-delete" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                    <a asp-action="Historial" asp-route-id="@material.IdMaterial" class="btn btn-sm btn-action-view" title="Historial">
                                        <i class="bi bi-clock-history"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/datatables-config.js"></script>
    <script>
        $(document).ready(function () {
            initDataTableSpanish('#tablaMateriales', {
                order: [[5, 'asc']], // Ordenar por Stock Actual
                columnDefs: [
                    { orderable: false, targets: @(User.IsInRole("Administrador") ? "-1" : "[]") }
                ]
            });
        });
    </script>
}
